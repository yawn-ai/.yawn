boundary:
  must_not_assume: []
  must_not_do: []
  presentation_must_not:
    - "change question_key while presenting the change as wording-only"
    - "silently create a durable preference"
    - "suppress safety, authority, privacy, provenance, or proof"
    - "treat an observer stance as a second Agent"
  anti_false_certainty:
    - "signal is not instruction"
    - "resonance is not proof"
    - "coincidence is not command"
    - "memory is not objective record"
    - "AI output is not authority"
    - "intensity is not truth"
    - "only authorized events update canonical materialized state"
    - "only suitable evidence or proof upgrades empirical claims"

move:
  invited: ""
  authorized: false
  reversible: true
  may_declare_success: false

