semantic_question_coverage:
  packet_ref: question-packets/orientation-nine.yawn
  # coverage_status: missing | partial | covered | stale. answer_status:
  # unasked | answered | proposed | corrected | skipped | unknown | disputed |
  # deferred | withheld | not_applicable. mapping_status: unmapped | proposed |
  # accepted | corrected | rejected. Statement and question-event refs preserve
  # attributed semantic records; question presentation never substitutes for them.
  by_key:
    scope: { coverage_status: missing, answer_status: unasked, mapping_status: unmapped, statement_refs: [], question_event_refs: [] }
    placement: { coverage_status: missing, answer_status: unasked, mapping_status: unmapped, statement_refs: [], question_event_refs: [] }
    perspective: { coverage_status: missing, answer_status: unasked, mapping_status: unmapped, statement_refs: [], question_event_refs: [] }
    current-state: { coverage_status: missing, answer_status: unasked, mapping_status: unmapped, statement_refs: [], question_event_refs: [] }
    intent: { coverage_status: missing, answer_status: unasked, mapping_status: unmapped, statement_refs: [], question_event_refs: [] }
    lacuna: { coverage_status: missing, answer_status: unasked, mapping_status: unmapped, statement_refs: [], question_event_refs: [] }
    boundary: { coverage_status: missing, answer_status: unasked, mapping_status: unmapped, statement_refs: [], question_event_refs: [] }
    movement: { coverage_status: missing, answer_status: unasked, mapping_status: unmapped, statement_refs: [], question_event_refs: [] }
    proof: { coverage_status: missing, answer_status: unasked, mapping_status: unmapped, statement_refs: [], question_event_refs: [] }

