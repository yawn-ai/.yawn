id: ""
title: ""

kind: yawn
status: seed
version: "1.0.0"
created: ""
updated: ""

# Draft 0.2 structural context. These references connect this human-readable
# document to the executable Agency Holarchy module without claiming that this
# legacy full template is already the one complete .yawn serialization.
protocol_context:
  agent_space_ref: ""
  arena_ref: "" # Arena bounds relevance; it is not the world or this Yawn.
  primary_parent_yawn_ref: null # At most one; the primary-parent tree is acyclic.
  lateral_relation_refs: [] # overlaps | depends_on | supports | conflicts_with | supersedes | same_as
  active_turn_refs: [] # Turns may overlap, nest, wait, delegate, and resume.
  routing_proposal_ref: null
  structural_change_receipt_refs: []
  extensions: {} # Namespaced experimental data; never implicit authority.

source:
  template: templates/full.yawn
  origin: "" # self-report | conversation | transcript | repo | agent | artifact | observation
  raw_material: ""
  source_refs: []
  quotes: []
  privacy: private # private | shared | public
  consent:
    recorded_with_consent: unknown
    shareable_with: []
    do_not_share_with: []

movement:
  loop_status: orienting # dormant | orienting | awaiting_choice | moving | awaiting_proof | updating | holding | closed
  mode: hold # observe | ask | hold | test | move
  loop:
    - signal
    - orientation
    - choice
    - move
    - proof
    - update

observer:
  name: ""
  role: self # self | partner | agent | witness | group | unknown
  position: ""
  attention: ""
  body_state: ""
  emotional_tone: ""
  agency_level: unknown # low | medium | high | unknown

field:
  name: ""
  slice: ""
  context: ""
  environment: ""
  relationship_context: ""
  time_horizon: ""
  constraints: []
  available_resources: []

signal:
  raw: ""
  noticed: ""
  body_cues: []
  emotions: []
  repeated_pattern: ""
  why_it_has_attention: ""

state:
  materialized:
    event_cursor: 0
    state_hash: ""
    reducer_version: yawn-state-reducer.v1
    lifecycle_status: draft
  snapshots:
    - id: ""
      scope_ref: ""
      description: ""
      attributed_to: ""
      modal_role: actual # actual | possible | predicted | counterfactual
      motivational_role: neutral # desired | feared | neutral
      epistemic_status: reported # reported | observed | inferred | assumed | supported | disputed | unknown | unproven
      source_refs: []
  possibilities: []
  unknowns: []

desires:
  - id: ""
    principal_ref: ""
    description: ""
    source_refs: []
    authority_status: self_reported # self_reported | inferred | endorsed | rejected
    visibility: private # private | shared | public

target_conditions: [] # optional; see core/target-and-lacuna.yawn

status_dimensions:
  lifecycle: draft
  authority: proposed
  loop: orienting
  axis_resolution: potential
  presentation: preview

compatibility_aliases:
  frame.current: "read as an attributed state snapshot"
  frame.possible: "read as a possibility or target candidate according to context"
  possible_kind.desired: "read as desire plus proposed attain-target; never ratified goal"
  measurement.desired: "read as attributed desire candidates"

lacuna:
  gap: ""
  missing_bridge: ""
  open_questions: []
  what_would_make_this_clearer: ""

orientation_stack:
  beliefs: []
  habits: []
  values: []
  needs: []
  desire_refs: []
  fears: []
  body_patterns: []
  relationship_patterns: []
  constraints: []
  access: []
  identity_frames: []
  prior_commitments: []
  hidden_loops: []

axis:
  clarity: unknown
  agency: unknown
  proofability: unknown
  reversibility: unknown
  risk: unknown
  embodiment: unknown
  coherence: unknown
  novelty: unknown
  permission_safety: unknown

relationship:
  applies: false
  kind: "" # marriage | friendship | family | work | community | self | other
  participants: []
  shared_context: ""
  shared_commitments: []
  explicit_requests: []
  implicit_expectations: []
  tensions: []
  repair_needed: []
  intimacy_context:
    applies: false
    desires: []
    boundaries: []
    fears: []
    open_questions: []
    consent_notes: []
  must_not_collapse:
    - "one person's inference into shared truth"
    - "desire into entitlement"
    - "fear into accusation"
    - "resonance into proof"

move:
  intent_id: ""
  from_state_hash: ""
  target_condition_refs: []
  invited: ""
  expected_delta: ""
  smallest_step: ""
  owner: ""
  reversible: true
  agency_cost: unknown # low | medium | high | unknown
  consent_required: []
  blocked_until: []
  alternatives: []
  stop_condition: ""
  proof_contract_ref: ""

boundary:
  must_not_assume: []
  must_not_force: []
  must_not_delegate: []
  must_not_publish: []
  must_ask_first: []
  blocked_effects:
    persistence_authorized: false
    external_effects_authorized: false
    relationship_claim_authorized: false
    agent_action_authorized: false
    public_sharing_authorized: false
  safety_notes: []
  anti_false_certainty:
    - "signal is not instruction"
    - "resonance is not proof"
    - "coincidence is not command"
    - "memory is not objective record"
    - "AI output is not authority"
    - "intensity is not truth"
    - "only authorized events update canonical materialized state"
    - "only suitable evidence or proof upgrades empirical claims"
    - "desire cannot authorize action"
    - "a move cannot mark itself successful"

proof:
  condition: ""
  status: not_started # not_started | gathering | passed | failed | mixed | abandoned
  evidence: []
  falsifier: ""
  confidence: unknown # low | medium | high | unknown
  timestamp: ""
  proof_receipts: []

transition_result:
  intent_ref: ""
  action_event_refs: []
  observed_delta: ""
  outcome_status: not_observed # not_observed | partial | proved | failed | mixed | contested
  residual_lacuna_refs: []
  unintended_effects: []

update:
  authorized_event_refs: []
  prior_state_hash: ""
  next_state_hash: ""
  changed_paths: []
  empirical_claim_refs: []
  reducer_version: yawn-state-reducer.v1

agent:
  role: mirror # mirror | organizer | challenger | summarizer | planner | blocked
  receives:
    - source
    - signal
    - state
    - desires
    - target_conditions
    - lacuna
    - orientation_stack
    - relationship
    - move
    - boundary
    - proof
  may:
    - "mirror the frame"
    - "separate observation from inference"
    - "name open questions"
    - "suggest bounded moves"
    - "ask for missing data"
  must_not:
    - "decide for the human"
    - "treat one person's inference as shared truth"
    - "turn desire into command"
    - "ignore consent"
    - "claim proof without evidence"
    - "silently mutate memory or canon"

coherence:
  parent_yawns: [] # Legacy compatibility only; migrate the first to primary_parent_yawn_ref.
  child_yawns: [] # Derived index in Draft 0.2, not canonical containment data.
  supports: []
  conflicts_with: []
  depends_on: []
  proof_gaps: []
  echoes: []
  source_hashes: []
  unresolved_tensions: []
  recoherence_suggestions: []

replay:
  before: ""
  after: ""
  changed: []
  did_not_change: []
  learned: []
  still_open: []
  next_questions: []
  next_yawn: ""
