  - templates/turn.yawn
  - templates/routing-proposal.yawn
  - templates/structural-change-receipt.yawn
  - templates/objective-holon.yawn
  - templates/orientation-shape.yawn
  - question-packets/orientation-nine.yawn
  - core/inquiry-selection.yawn
  - schemas/orientation-map.v0.1.schema.json
  - schemas/inquiry-selection-receipt.v0.1.schema.json
  - schemas/node.yawn

related_question_packets:
  basic: question-packets/basic.yawn
  relationship: question-packets/relationship.yawn
  orientation: question-packets/orientation-nine.yawn

