id: interface/objective-compiler
title: "dialogue objective compiler"
kind: interface-contract
status: draft-0.1
updated: 2026-08-28

definition: >
  Natural language is source input. The compiler preserves it, emits typed
  provisional detections, proposes structural operations, and waits for the
  rightful principal to confirm, reject, correct, add, split, link, or hold.

default_voice:
  mode: protocol
  personality_profile_ref: null
  emits:
    - signal-received
    - detected
    - reported
    - inferred
    - unresolved
    - requires-confirmation
    - proposed-structure
    - proposed-operation
    - receipt

detection_kinds:
  - agent
  - principal
  - observation
  - relationship
  - desire
  - value
  - objective_candidate
  - arena
  - lacuna
  - constraint
  - boundary
  - affordance
  - proof_condition

correction_operators:
  - confirm
  - reject
  - correct
  - add_more
  - split
  - link
  - hold

interaction_operator_contract:
  schema_ref: schemas/interaction-operator-receipt.v0.1.schema.json
  confirm_reject_review_scopes: [detection_mapping, proposal_review]
  question_response_operators: [answer, correct, mark_unknown, mark_disputed, skip, defer, withhold, mark_not_applicable]
  rule: >
    A review receipt records an interaction disposition only. Confirmation is
    not truth, objective ratification, bot activation, authority, canonical
    mutation, or permission for an external effect.

surface_label_mapping:
  applies_to_review_scopes: [detection_mapping, proposal_review]
  yes_or_agree: confirm
  no_or_disagree: reject
  edit_or_not_quite: correct
  add_more: add_more
  question_event_rule: "Yes or no offered as an answer emits answer, not confirm or reject."
  rule: "Labels may fit local context; clicks emit the scope-valid canonical operator in a receipt."

choice_architecture:
  model: "ranked decision policy over currently valid semantic and structural operations"
  hard_gates_before_ranking:
    - rightful-principal-and-decision-authority
    - privacy-visibility-and-egress
    - source-and-dispute-preservation
    - existing-yawn-and-relation-fit
    - objective-independence
    - proof-and-causal-boundary
  primary_correction_controls: [confirm, reject, correct, add_more]
  maximum_suggested_structural_paths: 3
  full_operator_access: inspectable
  score_kinds:
    heuristic: "relative ranking signal; not a probability"
    estimated_posterior: "calibrated estimate of structural fit given the current evidence"
  rule: >
    Show the few highest-value valid operations, their structural consequence,
    and the uncertainty that changes the ranking. Do not present a probabilistic
    guess as the user's objective or hide the remaining operators.

structural_operators:
  - attach_to_existing_yawn
  - create_objective_holon
  - create_child_worker
  - create_sibling
  - link_yawns
  - propose_merge
  - propose_split

activation_operators:
  - activate
  - inspect_contract
  - keep_sleeping
  - pause
  - retire

governed_objective_lifecycle:
  confirm_interpretation_or_proposal:
    receipt: InteractionOperatorReceipt
    canonical_effect: none
  ratify_objective:
    receipt: RatificationReceipt
    canonical_effect: ratified-objective-only
    yawn_and_bot_refs: optional-proposal-context-not-materialization
  create_yawn:
    receipt: schemas/agency-holarchy.v0.2.schema.json#/$defs/StructuralChangeReceipt
    operation: create_yawn
    requires: [exact-proposed-routing-proposal, rightful-authority, current-head-check]
  bind_sleeping_bot:
    receipt: BotBindingReceipt
    transition: absent-or-proposed-to-sleeping
    requires: [resolved-structural-change-receipt, rightful-principal, current-head-check]
    canonical_effect: bot-binding-only
  activate:
    receipt: ActivationReceipt
    requires: [authenticated-principal, exact-authority-grant-resolution, current-lifecycle-state, receipt-id-idempotency]
    canonical_effect: bounded-bot-activation-only-after-external-resolution
    effect_authority: false
  objective_linked_materialization_conformance: unavailable-until-aggregate-cross-document-resolver

rendering_rule: >
  Show the data model fields that materially affect interpretation, routing,
  authority, or movement. Put uncertainty on the individual detection. Do not
  replace the parse with anthropomorphic reassurance or hide structural
  consequences behind conversational copy.

copy_boundary:
  avoid_by_default:
    - "I think I'm hearing"
    - "I may be wrong"
    - simulated-emotional-reassurance
  prefer:
    - SIGNAL-RECEIVED
    - SIGNAL-COMPILED
    - DETECTED
    - INFERRED
    - UNRESOLVED
    - REQUIRES-CONFIRMATION

invariants:
  - source language remains inspectable
  - reported human content remains distinct from machine inference
  - clicks create explicit receipts rather than retroactively rewriting source
  - interaction confirmation is not objective ratification
  - a ratified objective may exist without a Yawn and a Yawn may exist without a bot
  - ratify_objective, authorized create_yawn, sleeping bot binding, and bot activation require separate receipts
  - a BotBindingReceipt cannot ratify an objective, create a Yawn, activate a bot, grant authority, or authorize an effect
  - local ActivationReceipt validation cannot apply activation or authenticate authority
  - no objective candidate becomes canonical through confidence alone
  - no bot gains effect authority through nesting or duplication
