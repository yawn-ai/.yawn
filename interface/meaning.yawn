id: interface/meaning
title: "/meaning"
kind: cognition-handle
status: v1
updated: 2026-07-21

function: "separate attributed state, possibility, desire, optional target, and typed lacuna"

asks:
  - what does this mean to the observer
  - what possible state is visible
  - what is the lacuna
  - what is desired, feared, called, avoided, or unknown

output:
  state_snapshots: []
  possibilities: []
  desires: []
  target_conditions: []
  lacunae: []
  status_dimensions:
    modal: "actual | possible | predicted | counterfactual"
    motivational: "desired | feared | neutral"
    epistemic: "reported | observed | inferred | assumed | supported | disputed | unknown | unproven"

compatibility: >
  possible_kind remains readable only at legacy edges. It must not mix modal,
  motivational, or epistemic meaning in canonical records.

proof:
  source:
    - readme.yawn
    - core/lacuna.yawn
  status: seed-backed
