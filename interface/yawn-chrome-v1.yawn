id: interface/yawn-chrome-v1
title: "YAWN chrome contract v1"
kind: interface-contract
status: active
updated: 2026-08-11

types:
  lens:
    - ai
    - bot
    - network
    - city
  shell_mode:
    - public
    - member
  bandwidth:
    - less
    - context
    - map
  connection_state:
    - local
    - connected
    - transmitting
    - ready

member_header:
  left:
    - lens-specific mark and YAWN wordmark
    - YAWN.bot robot mark is the sidebar toggle
    - active intelligence badge is attached to the upper-right of the YAWN.bot mark
    - back and forward controls
  center:
    - coordinate route tab
    - lens and intelligence selector
  right:
    - feedback
    - new Yawn
    - notifications
    - account

member_sidebar_default:
  - new-yawn
  - search
  - sources
  - actions
  - pinned

orientation_surface:
  default_bandwidth: less
  maximum_ranked_movements: 3
  maximum_immediate_actions: 2
  inspector_default: collapsed
  required:
    - you-are-here
    - next-choice
    - why-this-disclosure
    - proof-or-change

public_bot:
  identity_control:
    mark: pixel-robot
    action: explicit-navigation-drawer-toggle
    default_state: closed
  intelligence_workspace:
    triggers:
      - active-intelligence-badge
      - current-yawn-composer-intelligence-control
    presentation: full-body
    subject_scope_label: required-when-opened-from-a-yawn
    default_view: available-only
    processing_controls:
      - model
      - effort
      - speed
      - advanced
    provider_catalog:
      lanes:
        - local
        - cloud
      entry_action: add-intelligence
    availability_rule: only genuinely usable models appear available or selectable
    pending_rule: an added provider remains connection-required until securely connected
    local_proof_boundary:
      - no provider secret storage
      - no live model request
  feedback:
    active_header_state:
      targeting_indicator: ellipsis
      cancel_control: icon-x
      floating_instruction_banner: prohibited
    sequence:
      - enter-target-selection
      - highlight-registered-component
      - select-component
      - infer-bounded-change-suggestions
      - hold-human-intent-in-local-thread
    boundary: no feedback action executes or transmits by itself

invariants:
  - default chrome uses the least visible copy needed for one state and one next action
  - explanatory copy and taxonomy follow explicit intent or disclosure instead of surrounding a self-explanatory control
  - icon-only controls always keep an accessible name
  - lens changes never mutate semantic state
  - scroll zoom depth and bandwidth never create semantic events
  - play is not shown when the surface has no playable sound
  - source is never replaced by interpretation
  - public acquisition never opens a sidebar without an explicit identity-control action
  - provider discovery never represents setup-required intelligence as available
  - target feedback preserves selected component context and human-authored intent separately

schema_version: yawn.chrome.v1
