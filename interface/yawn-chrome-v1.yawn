id: interface/yawn-chrome-v1
title: "YAWN chrome contract v1"
kind: interface-contract
status: active
updated: 2026-08-14

types:
  lens:
    - ai
    - bot
    - network
    - city
  shell_mode:
    - public
    - member
  bandwidth:
    - less
    - context
    - map
  connection_state:
    - local
    - connected
    - transmitting
    - ready

surface_classes:
  public_root:
    purpose: quiet host entry
    required:
      - host-specific brand link
      - current coordinate
      - github protocol link
      - sign-in or account boundary when relevant
    prohibited:
      - authenticated sidebar
      - interface lens
      - type taxonomy
      - repository status
      - qr action
      - download action
      - contextual action rail
      - explanatory header copy
    body_rule: one centered governing question or one concise host-role statement
  public_view:
    purpose: public-safe rendering of a canonical coordinate
    header: same geometry and base slots as public_root
    observation_contract: interface/yawn-observation-view-v1
    disclosure_rule: >
      Route-specific action, reason, download, QR, snapshot hash, and bot tools
      appear in the body or one explicit inspection disclosure only when the
      route has valid public projection data for them.
    semantic_boundary:
      - a View is a rebuildable rendering, not an ontological Projection
      - a primary action is an affordance or proposal, not authority or a Move
  member:
    purpose: authenticated orientation and action workspace
    contract: member_header

public_header_geometry:
  desktop_height: 56px
  mobile_height: 52px
  desktop_inline_padding: 20px
  mobile_inline_padding: 12px
  control_size: 40px
  control_radius: 6px
  divider: "1px solid #343434"
  background: "#181716"
  focus: "#2fe3f4"
  invariant: one row without horizontal overflow

member_header:
  left:
    - lens-specific mark and YAWN wordmark
    - YAWN.bot robot mark is the sidebar toggle
    - active intelligence badge is attached to the upper-right of the YAWN.bot mark
    - back and forward controls
  center:
    - coordinate route tab
    - lens and intelligence selector
  right:
    - feedback
    - new Yawn
    - notifications
    - account

member_sidebar_default:
  - new-yawn
  - search
  - sources
  - actions
  - pinned

orientation_surface:
  default_bandwidth: less
  maximum_ranked_movements: 3
  maximum_immediate_actions: 2
  inspector_default: collapsed
  required:
    - you-are-here
    - next-choice
    - why-this-disclosure
    - proof-or-change

public_bot:
  identity_control:
    mark: pixel-robot
    action: explicit-navigation-drawer-toggle
    default_state: closed
  intelligence_workspace:
    triggers:
      - active-intelligence-badge
      - current-yawn-composer-intelligence-control
    presentation: full-body
    subject_scope_label: required-when-opened-from-a-yawn
    default_view: available-only
    processing_controls:
      - model
      - effort
      - speed
      - advanced
    provider_catalog:
      lanes:
        - local
        - cloud
      entry_action: add-intelligence
    availability_rule: only genuinely usable models appear available or selectable
    pending_rule: an added provider remains connection-required until securely connected
    local_proof_boundary:
      - no provider secret storage
      - no live model request
  feedback:
    active_header_state:
      targeting_indicator: ellipsis
      cancel_control: icon-x
      floating_instruction_banner: prohibited
    sequence:
      - enter-target-selection
      - highlight-registered-component
      - select-component
      - infer-bounded-change-suggestions
      - hold-human-intent-in-local-thread
    boundary: no feedback action executes or transmits by itself

invariants:
  - default chrome uses the least visible copy needed for one state and one next action
  - explanatory copy and taxonomy follow explicit intent or disclosure instead of surrounding a self-explanatory control
  - icon-only controls always keep an accessible name
  - lens changes never mutate semantic state
  - scroll zoom depth and bandwidth never create semantic events
  - play is not shown when the surface has no playable sound
  - source is never replaced by interpretation
  - public acquisition never opens a sidebar without an explicit identity-control action
  - provider discovery never represents setup-required intelligence as available
  - target feedback preserves selected component context and human-authored intent separately
  - yawn.ai and yawn.bot public roots use the same header geometry and canonical brand tokens
  - host identity and coordinate may change between applications; interaction grammar does not
  - public-root simplicity supersedes universal expanded Public View header requirements

schema_version: yawn.chrome.v1
