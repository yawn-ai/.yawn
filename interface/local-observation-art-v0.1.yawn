id: interface/local-observation-art-v0.1
title: "Local observation-art contract v0.1"
kind: interface-contract
status: proposed
updated: 2026-08-15

definition: >
  A local observation-art turn compiles one attributed, source-preserved
  observation into a deterministic visual brief, then may render candidate
  images through an explicitly granted local ComfyUI effect. The brief is a
  proposal for a possible Projection; generated bytes are candidate artifacts.
  A Projection occurs only when an attributed Agent actually expresses a
  candidate into an Arena. None replaces the Observation, proves its
  interpretation, or enters canonical state by itself.

coordinate:
  local_route: /local/art
  default_source_route: /observation
  availability: loopback-development-only
  production_default: unavailable

observation_boundary:
  preserve_separately:
    - what_arrived
    - where_the_observer_stood
    - what_the_observer_added
    - what_remains_open
    - visual_intention
    - rendered_candidate_artifact
    - expressed_projection
    - observed_consequence
  rules:
    - generated imagery never backfills what_arrived
    - visual intention is what the attributed Agent means to express
    - a rendered image is a candidate artifact and may miss that intention
    - displaying a candidate by an attributed Agent in a review Arena is a Projection
    - page composition and serialization are rebuildable Views, not canonical state
    - inspection of the rendered consequence may produce a new Observation
    - model output remains an attributed proposal until separate human approval

question_art_chain:
  order:
    - canonical_observation
    - organized_open_question_proposal
    - deterministic_art_brief_proposal
    - exact_local_effect_grant
    - hash_bound_local_art_candidate
    - accessible_review_view
    - separate_human_decision
  live_question:
    semantic_center: true
    rendered_as_accessible_text: required
    rendered_only_as_image_pixels: forbidden
    survives_image_failure_or_disablement: required
  iconic_agent_face:
    role: reflective_agent_not_authority
    may_support_question: true
    may_replace_question: false
  state_boundary:
    question_is_proposal: true
    brief_is_proposal: true
    candidate_is_proposal: true
    view_is_rebuildable: true
    automatic_acceptance_or_publish_or_promotion: forbidden

deterministic_brief:
  canonicalization: canonical-json-utf8
  digest: sha256
  required:
    - brief_version
    - source_coordinate
    - source_snapshot_hash
    - attributed_observer
    - arena
    - observation_distinctions
    - target_page_coordinate
    - visual_intention
    - intended_audience
    - accessible_description
    - semantic_color_roles
    - source_asset_hashes
    - dimensions
    - negative_constraints
  invariants:
    - identical canonical inputs produce the same brief hash
    - ordering is stable before hashing
    - seed is explicit and never silently regenerated on retry
    - source wording and machine-authored additions remain attributable
    - prompt text cannot widen the effect grant
    - raw private source bodies stay out of renderer prompts unless separately disclosed in the grant
    - renderer nondeterminism is disclosed and measured by output hashes

local_effect_grant:
  effect: local-gpu-image-generation
  issued_by: local-operator
  issued_through: explicit-user-action
  required_scope:
    - grant_id
    - principal_handle
    - brief_hash
    - workflow_profile_hash
    - workflow_hash
    - allowed_loopback_origin
    - maximum_candidate_count
    - maximum_width
    - maximum_height
    - allowed_seed_or_seed_range
    - private_output_namespace
    - expires_at
  before_render:
    - verify the grant is current and bound to the exact brief
    - verify the configured ComfyUI origin resolves to loopback
    - verify candidate and dimension limits
    - verify workflow and source asset hashes
  fixed_denials:
    external_network_egress: false
    paid_provider_call: false
    provider_secret_storage: false
    canonical_state_mutation: false
    automatic_publication: false
    automatic_promotion: false
  dry_run:
    requires_effect_grant: false
    may_compile_and_hash_brief: true
    may_contact_comfyui: false

pipeline:
  - preserve-observation-and-source
  - compile-deterministic-brief
  - present-brief-and-local-effect-boundary
  - receive-explicit-local-effect-grant
  - enqueue-one-bounded-candidate
  - render-through-local-comfyui
  - validate-and-hash-output
  - emit-candidate-and-proof-receipt
  - pause-for-human-review
  - accept-reject-or-revise
  - promote-through-a-separate-approval

langgraph_role:
  may:
    - compile and validate the brief
    - preserve attributed stage state
    - checkpoint candidate status
    - pause before effects and promotion
    - prepare proof and revision proposals
  may_not:
    - serve as canonical state
    - infer its own effect grant
    - call a renderer before the grant check
    - approve or promote a candidate
    - act as an unbounded durable job queue

comfyui_candidate_adapter:
  origin: server-configured-loopback-only
  workflow: versioned-api-workflow-with-explicit-node-bindings
  client_may_not_supply:
    - comfyui-origin
    - filesystem-path
    - workflow-node-id
    - checkpoint-path
  submission:
    - validate bounded request against the grant
    - submit once and retain the returned prompt id
    - return job state without holding an unbounded server request open
  status:
    - poll for a bounded time
    - stopping browser tracking never claims to cancel the ComfyUI job
    - never duplicate a known prompt id after refresh or retry
  output:
    - accept only output descriptors returned for the known prompt id
    - validate filename subfolder media type dimensions and byte limit
    - proxy approved local output through a same-origin bounded endpoint
    - never trust a client-supplied output path

phaser_projection:
  role: presentation-only
  may:
    - preview a candidate as a sprite or scene layer
    - reference the same source snapshot brief and candidate hashes
    - compare intended expression with rendered consequence
  may_not:
    - become another graph or state store
    - generate or approve an image
    - write canonical state
    - treat spatial position as semantic truth

candidate_receipt:
  required:
    - candidate_id
    - brief_hash
    - grant_id
    - workflow_hash
    - model_or_checkpoint_hash_when_available
    - seed
    - renderer_parameters
    - comfyui_prompt_id
    - output_sha256
    - media_type
    - width
    - height
    - created_at
    - accessible_description
    - validation_result
  privacy:
    - raw private source is excluded from logs and receipts
    - prompt excerpts are included only when explicitly approved for disclosure

proof:
  preconditions:
    - exact brief and workflow hashes exist
    - local ComfyUI health is verified
    - exact local-effect grant is valid
  prediction:
    - one bounded candidate is produced without network egress or canonical mutation
  postconditions:
    - candidate bytes dimensions media type and sha256 are verified
    - grant and prompt ids reconcile to one submission
    - source Observation visual Intention candidate artifact and any expressed Projection remain distinct
    - failure cancellation and timeout state are inspectable
  verifier:
    - automated contract and adapter tests
    - local browser proof of dry-run grant render review and rejection paths
    - outbound-network denial proof
  falsifier:
    - any ungranted render cloud request duplicate submission path traversal automatic promotion or canonical write

promotion:
  status_before_approval: candidate
  effect_grant_authorizes_promotion: false
  required_separate_approval:
    - authenticated principal
    - candidate output hash
    - target coordinate
    - intended role such as decorative explanatory or sprite
    - approved accessible description
    - timestamp
  result: append-only-promotion-event
  rules:
    - visual quality scores never authorize promotion
    - rejection preserves the receipt without publishing the asset
    - revision creates a new brief and candidate lineage
    - a promoted asset remains a projection and not proof of the depicted claim

implementation_projection:
  repository: yawn-ai/yawn.bot
  branch: codex/local-art-pipeline
  surfaces:
    - /local/art
    - /api/local-art/brief
    - /api/local-art
    - /api/local-art/{prompt_id}
    - /api/local-art/{prompt_id}/image/{image_index}
  current_proof:
    - deterministic LangGraph brief and stable hash
    - exact checked-in robot source hash
    - canonical YAWN semantic palette
    - loopback-only provider origin
    - private hash-pinned workflow profile
    - brief workflow and exact seed bound into the explicit grant
    - durable pre-dispatch receipt with unknown-dispatch fail-closed behavior
    - bounded same-origin output proxy
    - pure candidate acceptance and asset-packet proposal bridge
  open_lacunae:
    - no ComfyUI installation or reviewed workflow profile is currently present on the local machine
    - no real rendered canary has been authorized or produced
    - output byte hash and image-dimension proof are required before the acceptance bridge but are not yet emitted by the studio UI
    - authenticated candidate acceptance and Phaser preview remain separate later turns
    - the local studio is intentionally unavailable in production

schema_version: yawn.local_observation_art.v0.1
