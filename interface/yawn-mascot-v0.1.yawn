        rule_id: domain-term-transcription
        confidence: 0.75
        ambiguity_note: "Inferred from the existing yawn.bot favicon robot mark; preserved as raw in case another referent was meant."
        reviewed_by: null
        reviewed_at: null
      - raw: "ultra code / ultracode"
        normalized: "Ultracode (a Claude effort setting; not a YAWN term)"
