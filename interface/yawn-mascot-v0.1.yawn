      - raw: "non dot bot slash mascot"
        normalized: "yawn.bot/mascot"
        rule_id: invalid-product-host-spoken
        confidence: 0.97
        reviewed_by: null
        reviewed_at: null
      - raw: "YON at YAWN user"
        normalized: "the root YAWN account (@yawn) as owner"
        rule_id: invalid-product-name-spoken
        confidence: 0.9
        reviewed_by: null
        reviewed_at: null
      - raw: "whole larky / hold on a yawn bot system"
        normalized: "holarchy / holonic YAWN.bot system"
        rule_id: domain-term-transcription
