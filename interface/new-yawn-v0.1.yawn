id: interface/new-yawn-v0.1
title: "+ Yawn creation contract v0.1"
kind: interface-contract
status: active
updated: 2026-08-25

definition: >
  + Yawn preserves one signal and compiles typed provisional detections before
  proposing a private draft holon. The creation surface and the Yawn surface
  are the same object at different resolutions; it is not a conventional
  onboarding form.

compiler_projection:
  contract: interface/objective-compiler.yawn
  default_voice: concise-protocol
  personality_default: null
  visible_fields:
    - source-preserved-signal
    - typed-detections-with-per-field-status-and-confidence
    - objective-candidate
    - proposed-parent-yawn
    - proposed-objective-yawn
    - proposed-sleeping-bot
  correction_operators: [confirm, reject, correct, add_more, split, link, hold]
  rule: >
    Chips are examples and escape hatches, not ontological categories. The
    compiled data model remains underneath the interface.

question_projection_rule: >
  The nine questions are a canonical human orientation projection over the
  ontology, not nine mandatory storage fields and not the ontology itself.
  Interfaces may ask a smaller adaptive subset. Skipped answers remain visible
  lacunae and are never fabricated.

opening:
  question: "What is pulling your attention?"
  visible_heading: none
  visible_helper_copy: none
  question_presentation: accessible-composer-name
  supported_inputs:
    - free-form text
    - speech after an explicit user action
    - local file reference
    - pasted message
    - explicitly selected existing object

semantic_planes:
  - world
  - epistemic
  - normative
  - action

canonical_questions:
  - key: scope
    question: "What is this Yawn about?"
  - key: parent
    question: "Where does it belong?"
  - key: perspective
    question: "Whose perspective is represented, and who is affected?"
  - key: current-state
    question: "What appears to be happening now?"
  - key: intent
    question: "What are you trying to make true, preserve, learn, avoid, repair, coordinate, decide, or accept—and why?"
  - key: lacuna
    question: "What is unknown, disputed, constrained, dependent, or in tension?"
  - key: boundary
    question: "What must be protected, and who may decide or act?"
  - key: movement
    question: "What can move next?"
  - key: proof
    question: "What would reality have to show for this Yawn to update or close?"

adaptive_surface:
  maximum_foreground_questions: 3
  all_questions_default: collapsed
  priority:
    - safety-or-authority-blocker
    - movement-critical-missing-information
    - high-consequence-low-confidence-claim
    - contradiction-or-dispute
    - stale-high-impact-information
    - high-expected-information-value
    - low-effort-material-orientation-gain

creation_readiness:
  - signal-captured
  - yawn-created
  - oriented
  - ready-to-move
  - ready-to-delegate
  - ready-to-verify
  - updated-or-closed

coordinator_default:
  may:
    - observe
    - ask
    - propose
  may_not:
    - perform-external-actions
    - message-people
    - spend-money
    - widen-permissions
    - silently-share-parent-context
    - convert-inference-to-user-endorsed-truth
    - ratify-objective-from-confidence
    - activate-objective-bot
    - close-without-proof-or-explicit-human-closure

runtime_0_1:
  route: /new
  add_menu:
    trigger: plain-plus
    presentation: compact-context-menu
    first_action: files-and-folders
    first_action_status: working
  intelligence_control:
    mobile_label: Y1
    desktop_label: YAWN 1 · LOCAL
    action: open-shared-full-body-intelligence-workspace
    scope_label: THIS YAWN
    accessible_name_required: true
  storage: versioned-browser-local-draft
  creation: automatic-on-first-nonempty-signal
  autosave:
    strategy: debounce-plus-page-hide-flush
    persistence: browser-local
    manual_buttons: none
  projection: explicit-local-langgraph-run
  typing_network_requests: none
  live_model_calls: none
  database_mutation: none
  external_effects_authorized: false
  visual_field:
    background: subtle-grid-only
    visible_taxonomy_headers: none
    circular_status_motifs: none

invariants:
  - the Yawn is the holon and the Coordinator operates inside it
  - objective detection, ratification, Yawn creation, bot binding, and bot activation remain distinct
  - original source language is preserved
  - a proposal is never presented as a confirmed answer
  - confidence describes representational fit rather than absolute truth or importance
  - freshness and confidence remain separate
  - permissions never silently widen
  - every readiness state is eligible for automatic browser-local saving
  - questions may reopen when evidence context participants or purpose changes
  - orientation coverage claim confidence and routing confidence remain separate
  - high question coverage never implies truth or authorization

schema_version: yawn.new.v0.1
