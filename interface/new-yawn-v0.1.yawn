id: interface/new-yawn-v0.1
title: "+ Yawn creation contract v0.1"
kind: interface-contract
status: active
updated: 2026-08-27

definition: >
  + Yawn preserves one signal and compiles typed provisional detections before
  proposing a private draft holon. The creation surface and the Yawn surface
  are the same object at different resolutions; it is not a conventional
  onboarding form.

compiler_projection:
  contract: interface/objective-compiler.yawn
  default_voice: concise-protocol
  personality_default: null
  visible_fields:
    - source-preserved-signal
    - typed-detections-with-per-field-status-and-confidence
    - objective-candidate
    - proposed-parent-yawn
    - proposed-objective-yawn
    - proposed-sleeping-bot
  correction_operators: [confirm, reject, correct, add_more, split, link, hold]
  rule: >
    Chips are examples and escape hatches, not ontological categories. The
    compiled data model remains underneath the interface.

orientation_inquiry_rule: >
  The nine stable semantic axes are a human orientation projection over the
  ontology, not nine mandatory storage fields, a fixed interview order, or the
  ontology itself. Interfaces ask one useful question by default and may expose
  up to three candidate paths. Skipped answers remain typed lacunae and are
  never fabricated.

opening:
  question: "What is pulling your attention?"
  visible_heading: none
  visible_helper_copy: none
  question_presentation: accessible-composer-name
  supported_inputs:
    - free-form text
    - speech after an explicit user action
    - local file reference
    - pasted message
    - explicitly selected existing object

semantic_planes:
  - world
  - epistemic
  - normative
  - action

canonical_question_packet:
  ref: question-packets/orientation-nine.yawn
  question_keys: [scope, placement, perspective, current-state, intent, lacuna, boundary, movement, proof]
  rule: "Prompt variants preserve question_key and its semantic destination."

adaptive_surface:
  default_foreground_questions: 1
  maximum_candidate_paths: 3
  all_questions_default: collapsed
  selection_policy_ref: core/inquiry-selection.yawn
  orientation_map_schema_ref: schemas/orientation-map.v0.1.schema.json
  selection_receipt_schema_ref: schemas/inquiry-selection-receipt.v0.1.schema.json
  selection_result:
    question_key: null
    rationale: null
    orientation_revision: null
    orientation_semantic_hash: null
    selection_receipt_ref: null
    preference_ref: null
    preference_hash: null
    prompt_variant: null
    exact_rendered_prompt: null
    representation_medium: accessible-text
    answer_input_adapter: null
    hold: null
  controls:
    - why-this-question
    - change-medium-or-input
    - show-the-map
    - pause-orientation
  prompt_adaptation_boundary: >
    Receipt V0.1 renders only the packet-pinned default prompt or deterministic
    hard-gate overlay. Alternate probes and adapted wording may be previewed as
    proposals, but asking them requires a later versioned receipt contract.
  accessibility:
    text_equivalent_required: true
    meaning_must_not_depend_on_color_position_or_audio_alone: true

orientation_inquiry_source:
  preserve_every_turn:
    - question_key
    - question_packet_version
    - exact_rendered_prompt
    - prompt_variant
    - selection_receipt_ref
    - policy_version
    - orientation_revision
    - reason_asked
    - sequence_position
    - representation_medium
    - answer_input_adapter
    - response_source_refs
    - answered_or_asserted_by
    - epistemic_status
    - answer_status
    - mapping_status
    - confidence
    - freshness
    - visibility
    - dispute_status
    - raw_response_or_content_addressed_source
    - parsed_claim_refs
    - correction_or_revision_ref
  rule: "Speech, text, and file answer_input_adapter values change capture form, not semantic identity."

presentation_profile:
  view_kind: orientation_inquiry
  accepted_preference_contract: schemas/projection-preference.v1.schema.json
  inferred_fit_status: proposed-only
  receipt_v0_1_may_change: [order, answer_input_adapter, representation_medium, accessibility]
  proposal_only_until_versioned_prompt_registry: [wording, chunking, density, pacing]
  may_not_change: [question_key, answer_meaning, safety, authority, privacy, provenance, proof]
  fixed_learning_style_diagnosis: prohibited

creation_readiness:
  - signal-captured
  - yawn-created
  - oriented
  - ready-to-move
  - ready-to-delegate
  - ready-to-verify
  - updated-or-closed

coordinator_default:
  may:
    - observe
    - ask
    - propose
  may_not:
    - perform-external-actions
    - message-people
    - spend-money
    - widen-permissions
    - silently-share-parent-context
    - convert-inference-to-user-endorsed-truth
    - ratify-objective-from-confidence
    - activate-objective-bot
    - close-without-proof-or-explicit-human-closure

runtime_0_1:
  route: /new
  add_menu:
    trigger: plain-plus
    presentation: compact-context-menu
    first_action: files-and-folders
    first_action_status: working
  intelligence_control:
    mobile_label: Y1
    desktop_label: YAWN 1 · LOCAL
    action: open-shared-full-body-intelligence-workspace
    scope_label: THIS YAWN
    accessible_name_required: true
  storage: versioned-browser-local-draft
  creation: automatic-on-first-nonempty-signal
  autosave:
    strategy: debounce-plus-page-hide-flush
    persistence: browser-local
    manual_buttons: none
  projection: explicit-local-langgraph-run
  typing_network_requests: none
  live_model_calls: none
  database_mutation: none
  external_effects_authorized: false
  visual_field:
    background: subtle-grid-only
    visible_taxonomy_headers: none
    circular_status_motifs: none

invariants:
  - the Yawn is the holon and the Coordinator operates inside it
  - objective detection, ratification, Yawn creation, bot binding, and bot activation remain distinct
  - original source language is preserved
  - every question and answer retains question_key, exact_rendered_prompt, representation_medium, answer_input_adapter, and sequence provenance
  - a proposal is never presented as a confirmed answer
  - confidence describes representational fit rather than absolute truth or importance
  - freshness and confidence remain separate
  - permissions never silently widen
  - every readiness state is eligible for automatic browser-local saving
  - questions may reopen when evidence context participants or purpose changes
  - orientation coverage claim confidence and routing confidence remain separate
  - high question coverage never implies truth or authorization
  - changing presentation does not change orientation semantics

schema_version: yawn.new.v0.1
