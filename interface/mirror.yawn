id: interface/mirror
title: "/mirror"
kind: cognition-handle
status: v0-seed
updated: 2026-08-25

function: "compile the present signal into an inspectable, correctable data-model projection"

asks:
  - what has attention
  - what signal is present
  - what body cue or emotion is present
  - what is known versus interpreted

output:
  source_preserved_signal: ""
  current_signal: ""
  typed_detections: []
  proposed_objective_candidates: []
  proposed_structure: []
  correction_operators: [confirm, reject, correct, add_more, split, link, hold]
  body_signal: ""
  open_questions: []

default_voice:
  mode: concise-protocol
  personality_profile_ref: null

boundary:
  - "A detection is not a ratified objective."
  - "A ratified objective is not bot activation or effect authority."

proof:
