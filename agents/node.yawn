id: agents/node
title: "agents node"
kind: mental-model-node
status: active-mixed
updated: 2026-08-27

purpose: >
  Hold the public mental model for AI agents working inside a YAWN space.

holds:
  - agent orientation
  - contributor agent
  - contributor architecture disclosure
  - yawn.bot service identity
  - repo-contributor module identity
  - repo-contributor module policy
  - first read order
  - allowed help
  - blocked hidden authority
  - access recording expectations
  - root steward, objective steward, and worker lifecycle roles
  - orientation_map reading and orientation_inquiry selection boundaries

receives:
  - readme.yawn
  - observations/lived-agency.yawn
  - proof and boundary files
  - material records

produces:
  - safe agent behavior
  - open-source contributor workflows
  - daily bot contribution posture
  - architecture-observer boundaries
  - handoff discipline
  - access records

questions:
  - what should an agent read first
  - how can an AI-assisted contributor disclose architecture
  - what can yawn.bot do today
  - what can yawn.bot never do
  - what can an agent safely infer
  - what must remain human-authorized
  - which objective this bot is bound to and whether it is sleeping or active
  - which question_key or explicit hold should orientation_inquiry surface

links:
  - agents/orientation.yawn
  - agents/yawn.bot.yawn
  - agents/repo-contributor.yawn
  - agents/yawn.bot.policy.yawn
  - agents/contributor-agent.yawn
  - agents/contributor-architecture.yawn
  - templates/agent-handoff.yawn
  - records/llm-access.yawn
  - core/objective-holon.yawn
  - core/orientation.yawn
  - core/inquiry-selection.yawn
  - question-packets/orientation-nine.yawn
  - schemas/orientation-map.v0.1.schema.json
  - schemas/inquiry-selection-receipt.v0.1.schema.json

proof:
  source:
    - agents/orientation.yawn
    - agents/yawn.bot.yawn
    - agents/repo-contributor.yawn
    - agents/yawn.bot.policy.yawn
    - agents/contributor-agent.yawn
    - core/inquiry-selection.yawn
    - schemas/inquiry-selection-receipt.v0.1.schema.json
    - question-packets/orientation-nine.yawn
    - readme.yawn
  status: draft-backed
