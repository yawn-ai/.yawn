id: core/proof-and-boundary
title: "proof and boundary"
kind: safety-protocol
status: v1
evaluation_extension_status: draft-0.1
updated: 2026-09-01

contract:
  state: "only authorized events update canonical materialized state"
  empirical: "only suitable evidence or proof upgrades empirical claims"

safety_rail:
  - signal is not instruction
  - resonance is not proof
  - coincidence is not command
  - memory is not objective record
  - ai output is not authority
  - intensity is not truth
  - confidence is not correctness
  - consequence is not judgment
  - Evaluation is not proof

labels:
  - known
  - inferred
  - imagined
  - desired
  - unproven
  - proved

separate_status_dimensions:
  - modal
  - motivational
  - epistemic
  - lifecycle
  - authority
  - loop
  - axis_resolution
  - presentation
  - evaluation
  - proof_adjudication

transition_boundary:
  - "Desire cannot authorize action."
  - "A recommendation cannot become rightful choice without an attributed choice event."
  - "Choice cannot authorize an external effect."
  - "A move cannot mark itself successful."
  - "A consequence records what became observable; it does not emit a universal verdict."
  - "An Evaluation records who assessed what, according to which criteria; it does not satisfy its own proof contract."
  - "Proof evaluates specified claims or results; it does not erase intent, cost, conflicting judgments, or unintended effects."
  - "Proof permits only the update covered by the relevant authority and event."

evaluation_boundary:
  canonical_term: Evaluation
  human_alias: Judgment
  draft_schema: schemas/evaluation-record.v0.1.schema.json
  required_distinctions:
    evaluator: "the attributed Agent, principal, delegate, or adjudicator making the assessment"
    target: "the Question, Position, provision, Projection, Move, Consequence, Evaluation, Proof state, Update, relationship, or criterion being assessed"
    criteria: "the goals, values, needs, norms, boundaries, predictions, preferences, contracts, or comparisons used"
    assessment: "criterion-level and overall direction with rationale"
    epistemic_status: "how the evaluator knows or infers the assessment"
    authority_status: "what role the evaluation has and does not have"
    proof_status: "not proof, proof candidate, or linked to a separate adjudication"
  rules:
    - "Multiple Evaluations may conflict without forced consensus."
    - "A principal's Evaluation may be decisive for their own preference or meaning while remaining non-authoritative for another principal or an external effect."
    - "A delegated Evaluation remains inside its grant and cannot silently inherit terminal goals or values."
    - "Evaluating an Evaluation opens metacognitive inquiry; recursion alone adds no evidence or authority."

allowed_material: >
  A .yawn may hold intuition, dreams, feelings, hypotheses, fears, hopes,
  interpretations, and judgments, but it should label and attribute them honestly.

proof_can_be:
  - observed outcome
  - completed authorized action
  - external artifact
  - timestamped note
  - message sent or received
  - body state after a move
  - changed constraint
  - replayed comparison between expectation and result

proof:
  source:
    - yawn.yawn
    - references/scientific-frame.yawn
    - templates/proof.yawn
    - migrations/2026-08-17-canonical-extension.yawn
    - core/source-bound-mental-model.yawn
  status: seed-backed-with-draft-evaluation-extension