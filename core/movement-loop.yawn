id: core/movement-loop
title: "movement loop"
kind: protocol
status: v1
updated: 2026-08-17

formal_loop:
  - signal
  - orient
  - choose
  - move
  - proof
  - update

human_loop:
  - notice the signal
  - orient to state
  - choose or hold
  - move
  - check proof
  - update the map

north_star_loop:
  - see the frame
  - name the lacuna
  - choose a bounded move
  - gather proof
  - replay what changed

stage_notes:
  signal: "capture what has attention without forcing action"
  orient: "name attributed state, possibilities, desires, targets, and lacunae without collapsing them"
  choose: "select a bounded move that preserves stability"
  move: "attempt the smallest authorized transition reality can answer"
  proof: "compare expected delta with observed evidence; the move cannot judge itself"
  update: "reduce authorized events and replay the materialized state"

holding_rule: >
  Some yawns are not ready for action. Holding can be the correct movement
  stage when proof, boundary, or stability is missing.

projection_rule: >
  Longer loops may project this cycle with richer labels, but must preserve the
  six canonical relations signal -> orientation -> choice -> move -> proof -> update.

proof:
  source:
    - yawn.yawn
    - core/co-orientation-loop.yawn
    - migrations/2026-08-17-canonical-extension.yawn
  status: seed-backed
