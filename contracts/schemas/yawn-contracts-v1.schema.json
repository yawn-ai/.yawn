{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yawn.ai/contracts/yawn-contracts-v1.schema.json",
  "title": "YAWN Contracts V1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Uuid": { "type": "string", "format": "uuid" },
    "Timestamp": { "type": "string", "format": "date-time" },
    "YawnConstitutionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "canonicalLoop", "upperOntology", "aiOutputPolicy", "targetPolicy", "authorityPolicy", "proofPolicy"],
      "properties": {
        "schemaVersion": { "const": "yawn.constitution.v1" },
        "canonicalLoop": { "const": ["signal", "orientation", "choice", "move", "proof", "update"] },
        "upperOntology": {
          "const": ["actor_agent", "agent_space", "arena", "observation_claim", "lacuna", "intent_goal_value", "boundary_authority", "move_action", "evidence_outcome_proof", "update_revision"]
        },
        "aiOutputPolicy": { "const": "proposal_until_authenticated_human_approval" },
        "targetPolicy": { "const": "optional" },
        "authorityPolicy": { "const": "child_subset_of_parent_plus_explicit_grant" },
        "proofPolicy": { "const": "preconditions_prediction_postconditions_verifier_falsifier" }
      }
    },
    "AgentSpace": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "ownerPrincipalId", "slug", "title", "constitutionVersion", "revision"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" }, "ownerPrincipalId": { "$ref": "#/$defs/Uuid" },
        "slug": { "type": "string" }, "title": { "type": "string" }, "constitutionVersion": { "const": "yawn.constitution.v1" },
        "revision": { "type": "integer", "minimum": 0 }, "stateSha256": { "anyOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] }
      }
    },
    "Arena": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "agentSpaceId", "slug", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" }, "agentSpaceId": { "$ref": "#/$defs/Uuid" }, "slug": { "type": "string" }, "title": { "type": "string" },
        "status": { "enum": ["proposed", "accepted", "rejected", "superseded"] }
      }
    },
    "YawnState": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "agentSpaceId", "arenaId", "parentYawnId", "title", "lacuna", "target", "authority", "revision", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" }, "agentSpaceId": { "$ref": "#/$defs/Uuid" },
        "arenaId": { "anyOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] }, "parentYawnId": { "anyOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] },
        "title": { "type": "string" }, "lacuna": { "type": "string" }, "target": { "type": ["object", "null"] },
        "authority": { "type": "object" }, "revision": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["proposed", "accepted", "rejected", "superseded"] }
      }
    },
    "SourceRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "importId", "sourceKey", "sourceKind", "assertedBy", "authorRole", "sourceSha256", "localOnly", "metadata"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" }, "importId": { "$ref": "#/$defs/Uuid" }, "sourceKey": { "type": "string" }, "sourceKind": { "type": "string" },
        "assertedBy": { "type": "string" }, "authorRole": { "enum": ["human", "assistant", "system", "tool", "unknown"] },
        "sourceSha256": { "$ref": "#/$defs/Sha256" }, "occurredAt": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "localOnly": { "type": "boolean" }, "metadata": { "type": "object", "not": { "required": ["raw_body"] } }
      }
    },
    "SourceSpan": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "conversationId", "messageId", "nodeId", "contentPart", "startCharacter", "endCharacter", "sourceSha256"],
      "properties": {
        "sourceId": { "type": "string" }, "conversationId": { "type": ["string", "null"] }, "messageId": { "type": ["string", "null"] },
        "nodeId": { "type": ["string", "null"] }, "contentPart": { "type": ["integer", "null"], "minimum": 0 },
        "startCharacter": { "type": "integer", "minimum": 0 }, "endCharacter": { "type": "integer", "minimum": 0 }, "sourceSha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "OrientationAtom": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "agentSpaceId", "arenaId", "yawnId", "epistemicKind", "text", "assertedBy", "sourceSpans", "confidence", "status", "inferenceRunId", "createdAt"],
      "properties": {
        "id": { "type": "string" }, "agentSpaceId": { "type": "string" }, "arenaId": { "type": ["string", "null"] }, "yawnId": { "type": ["string", "null"] },
        "epistemicKind": { "enum": ["observation", "claim", "lacuna", "intent", "goal", "value", "boundary", "action", "evidence", "outcome", "revision"] },
        "text": { "type": "string" }, "assertedBy": { "type": "string" }, "sourceSpans": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SourceSpan" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "status": { "const": "proposed" },
        "inferenceRunId": { "type": ["string", "null"] }, "createdAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "YawnCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "agentSpaceId", "title", "arenaId", "proposedParentYawnId", "lacuna", "intent", "evidenceAtomIds", "promotionReasons", "confidence", "status"],
      "properties": {
        "id": { "type": "string" }, "agentSpaceId": { "type": "string" }, "title": { "type": "string" }, "arenaId": { "type": ["string", "null"] },
        "proposedParentYawnId": { "type": ["string", "null"] }, "lacuna": { "type": "string" }, "intent": { "type": ["string", "null"] },
        "evidenceAtomIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "promotionReasons": { "type": "array", "items": { "enum": ["persistent", "consequential_lacuna", "authority_boundary", "requires_proof", "cross_arena_recurrence", "explicit_human_request"] } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "status": { "const": "proposed" }
      }
    },
    "ChangeProposal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "agentSpaceId", "proposalType", "targetId", "payload", "sourceAtomIds", "confidence", "status", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" }, "agentSpaceId": { "$ref": "#/$defs/Uuid" },
        "proposalType": { "enum": ["atom", "arena", "yawn", "link", "merge", "split", "promote", "demote", "revision"] },
        "targetId": { "anyOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] }, "payload": { "type": "object" },
        "sourceAtomIds": { "type": "array", "items": { "$ref": "#/$defs/Uuid" } }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "enum": ["proposed", "accepted", "rejected", "superseded"] }, "createdAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AuthorityGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "parentAuthorityId", "principalId", "scope", "capabilities", "approvedBy", "approvedAt", "revokedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" }, "parentAuthorityId": { "anyOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] },
        "principalId": { "type": "string" }, "scope": { "type": "object" }, "capabilities": { "type": "array", "items": { "type": "string" } },
        "approvedBy": { "$ref": "#/$defs/Uuid" }, "approvedAt": { "$ref": "#/$defs/Timestamp" },
        "revokedAt": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] }
      }
    },
    "ImportGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "importId", "sourceSha256", "provider", "allowedModels", "allowedReasoningEfforts", "remoteSourceTransferApproved", "budgetId", "approvedBy", "approvedAt", "revokedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" }, "importId": { "$ref": "#/$defs/Uuid" }, "sourceSha256": { "$ref": "#/$defs/Sha256" }, "provider": { "const": "openai" },
        "allowedModels": { "type": "array", "items": { "type": "string" } }, "allowedReasoningEfforts": { "type": "array", "items": { "type": "string" } },
        "remoteSourceTransferApproved": { "const": true }, "budgetId": { "$ref": "#/$defs/Uuid" }, "approvedBy": { "$ref": "#/$defs/Uuid" },
        "approvedAt": { "$ref": "#/$defs/Timestamp" }, "revokedAt": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] }
      }
    },
    "PricingSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "currency", "effectiveAt", "sourceUrl", "batchDiscountBasisPoints", "models"],
      "properties": {
        "id": { "type": "string" }, "currency": { "const": "USD" }, "effectiveAt": { "$ref": "#/$defs/Timestamp" }, "sourceUrl": { "type": "string", "format": "uri" },
        "batchDiscountBasisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 }, "models": { "type": "object", "additionalProperties": { "type": "object" } }
      }
    },
    "RunBudget": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "runId", "currency", "limitMicrousd", "softStopMicrousd", "actualMicrousd", "openReservationMicrousd", "pricingSnapshotId", "status", "authorizedBy", "authorizedAt", "supersedesBudgetId"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" }, "runId": { "$ref": "#/$defs/Uuid" }, "currency": { "const": "USD" },
        "limitMicrousd": { "type": "integer", "minimum": 0 }, "softStopMicrousd": { "type": "integer", "minimum": 0 },
        "actualMicrousd": { "type": "integer", "minimum": 0 }, "openReservationMicrousd": { "type": "integer", "minimum": 0 },
        "pricingSnapshotId": { "type": "string" }, "status": { "enum": ["active", "soft_stopped", "hard_stopped", "closed", "revoked"] },
        "authorizedBy": { "$ref": "#/$defs/Uuid" }, "authorizedAt": { "$ref": "#/$defs/Timestamp" },
        "supersedesBudgetId": { "anyOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] }
      }
    },
    "CostEstimate": {
      "type": "object", "additionalProperties": false,
      "required": ["pricingSnapshotId", "model", "batch", "inputTokens", "cachedInputTokens", "expectedOutputTokens", "maximumOutputTokens", "minimumMicrousd", "expectedMicrousd", "worstCaseMicrousd"],
      "properties": {
        "pricingSnapshotId": { "type": "string" }, "model": { "type": "string" }, "batch": { "type": "boolean" },
        "inputTokens": { "type": "integer", "minimum": 0 }, "cachedInputTokens": { "type": "integer", "minimum": 0 },
        "expectedOutputTokens": { "type": "integer", "minimum": 0 }, "maximumOutputTokens": { "type": "integer", "minimum": 0 },
        "minimumMicrousd": { "type": "integer", "minimum": 0 }, "expectedMicrousd": { "type": "integer", "minimum": 0 }, "worstCaseMicrousd": { "type": "integer", "minimum": 0 }
      }
    },
    "CostReservation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "budgetId", "requestKey", "estimate", "reservedMicrousd", "actualMicrousd", "providerRequestId", "status", "createdAt", "reconciledAt"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" }, "budgetId": { "$ref": "#/$defs/Uuid" }, "requestKey": { "type": "string" }, "estimate": { "$ref": "#/$defs/CostEstimate" },
        "reservedMicrousd": { "type": "integer", "minimum": 0 }, "actualMicrousd": { "type": ["integer", "null"], "minimum": 0 },
        "providerRequestId": { "type": ["string", "null"] }, "status": { "enum": ["open", "reconciled", "released", "failed_unknown_usage"] },
        "createdAt": { "$ref": "#/$defs/Timestamp" }, "reconciledAt": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] }
      }
    },
    "UsageLedgerEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "budgetId", "reservationId", "model", "inputTokens", "cachedInputTokens", "outputTokens", "reasoningTokens", "actualMicrousd", "providerRequestId", "recordedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" }, "budgetId": { "$ref": "#/$defs/Uuid" }, "reservationId": { "$ref": "#/$defs/Uuid" }, "model": { "type": "string" },
        "inputTokens": { "type": "integer", "minimum": 0 }, "cachedInputTokens": { "type": "integer", "minimum": 0 }, "outputTokens": { "type": "integer", "minimum": 0 },
        "reasoningTokens": { "type": "integer", "minimum": 0 }, "actualMicrousd": { "type": "integer", "minimum": 0 }, "providerRequestId": { "type": "string" },
        "recordedAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ModelRunReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "importId", "reservationId", "provider", "model", "reasoningEffort", "mode", "providerBatchId", "workflowRunId", "inputFileId", "outputFileId", "usage", "deletionReceiptIds", "status", "createdAt", "completedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" }, "importId": { "$ref": "#/$defs/Uuid" }, "reservationId": { "$ref": "#/$defs/Uuid" }, "provider": { "const": "openai" },
        "model": { "type": "string" }, "reasoningEffort": { "type": "string" }, "mode": { "enum": ["standard", "pro"] }, "providerBatchId": { "type": "string" },
        "workflowRunId": { "type": "string" }, "inputFileId": { "type": "string" }, "outputFileId": { "type": ["string", "null"] },
        "usage": { "anyOf": [{ "$ref": "#/$defs/UsageLedgerEntry" }, { "type": "null" }] }, "deletionReceiptIds": { "type": "array", "items": { "$ref": "#/$defs/Uuid" } },
        "status": { "enum": ["submitted", "in_progress", "completed", "failed", "expired", "cancelled", "usage_unknown"] },
        "createdAt": { "$ref": "#/$defs/Timestamp" }, "completedAt": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] }
      }
    },
    "RecordRef": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["actor", "principal", "agent_space", "arena", "observation", "yawn", "source", "proof", "view", "git_commit", "question_proposal", "art_brief", "art_candidate", "projection_feedback"] },
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": ["integer", "null"], "minimum": 0 },
        "stateSha256": { "anyOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] }
      }
    },
    "ManualSourceRecordV1": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourceKey", "sourceKind", "assertedBy", "authorRole", "sourceSha256", "localOnly", "metadata"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" }, "sourceKey": { "type": "string", "minLength": 1 },
        "sourceKind": { "const": "manual_observation" }, "assertedBy": { "type": "string", "minLength": 1 },
        "authorRole": { "const": "human" }, "sourceSha256": { "$ref": "#/$defs/Sha256" },
        "occurredAt": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "localOnly": { "type": "boolean" }, "metadata": { "type": "object", "not": { "required": ["raw_body"] } }
      }
    },
    "ObservationSourceSpanV1": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceRef", "sourceSha256", "startCharacter", "endCharacter", "coordinate"],
      "properties": {
        "sourceRef": { "type": "string", "minLength": 1 }, "sourceSha256": { "$ref": "#/$defs/Sha256" },
        "startCharacter": { "type": "integer", "minimum": 0 }, "endCharacter": { "type": "integer", "minimum": 0 },
        "coordinate": { "type": "object" }
      }
    },
    "ObservationStateV1": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "observationId", "observerRef", "agentSpaceRef", "arenaRef", "observedYawnRefs", "sourceSpans", "whatBecameAvailable", "observerAdded", "inferences", "conditions", "limits", "remainsOpen", "proofRefs", "epistemicStatus", "confidence", "status", "revision", "observedAt", "recordedAt", "updatedAt", "previousStateSha256", "extensions"],
      "properties": {
        "schemaVersion": { "const": "yawn.observation-state.v1" }, "observationId": { "type": "string", "minLength": 1 },
        "observerRef": { "type": "string", "minLength": 1 }, "agentSpaceRef": { "type": "string", "minLength": 1 },
        "arenaRef": { "type": ["string", "null"] }, "observedYawnRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "sourceSpans": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ObservationSourceSpanV1" } },
        "whatBecameAvailable": { "type": "string", "minLength": 1, "maxLength": 64000, "pattern": "\\S" },
        "observerAdded": { "type": "array", "items": { "$ref": "#/$defs/SourceStatementV1" } },
        "inferences": { "type": "array", "items": { "$ref": "#/$defs/InferenceStatementV1" } },
        "conditions": { "type": "array", "items": { "type": "string" } }, "limits": { "type": "array", "items": { "type": "string" } },
        "remainsOpen": { "type": "array", "items": { "type": "string" } }, "proofRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "epistemicStatus": { "enum": ["observed", "reported", "inferred", "assumed", "predicted", "disputed", "unknown"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "status": { "enum": ["accepted", "superseded"] },
        "revision": { "type": "integer", "minimum": 1 }, "observedAt": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "recordedAt": { "$ref": "#/$defs/Timestamp" }, "updatedAt": { "$ref": "#/$defs/Timestamp" },
        "previousStateSha256": { "anyOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] },
        "extensions": { "type": "object", "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$" } }
      }
    },
    "SourceStatementV1": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "assertedBy", "epistemicStatus", "confidence", "sourceSpanIndexes"],
      "properties": {
        "text": { "type": "string", "minLength": 1 }, "assertedBy": { "type": "string", "minLength": 1 },
        "epistemicStatus": { "enum": ["observed", "reported", "disputed", "unknown"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "sourceSpanIndexes": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "InferenceStatementV1": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "assertedBy", "epistemicStatus", "confidence", "sourceSpanIndexes"],
      "properties": {
        "text": { "type": "string", "minLength": 1 }, "assertedBy": { "type": "string", "minLength": 1 },
        "epistemicStatus": { "enum": ["inferred", "assumed", "predicted", "disputed", "unknown"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "sourceSpanIndexes": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "RecordEventV1": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "eventId", "subjectRef", "revision", "eventType", "actorRef", "authorityStatus", "payload", "previousStateSha256", "resultingStateSha256", "occurredAt"],
      "properties": {
        "schemaVersion": { "const": "yawn.record-event.v1" }, "eventId": { "type": "string", "minLength": 1 },
        "subjectRef": { "$ref": "#/$defs/RecordRef" }, "revision": { "type": "integer", "minimum": 1 }, "eventType": { "type": "string", "minLength": 1 },
        "actorRef": { "type": "string", "minLength": 1 }, "authorityStatus": { "enum": ["proposed", "authorized", "rejected"] },
        "payload": { "type": "object" }, "previousStateSha256": { "anyOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] },
        "resultingStateSha256": { "$ref": "#/$defs/Sha256" }, "occurredAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "RecordProofReceiptV1": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "receiptId", "subjectRef", "preconditions", "prediction", "postconditions", "verifier", "falsifier", "sourceRefs", "status", "recordedAt"],
      "properties": {
        "schemaVersion": { "const": "yawn.record-proof-receipt.v1" }, "receiptId": { "type": "string", "minLength": 1 },
        "subjectRef": { "$ref": "#/$defs/RecordRef" }, "preconditions": { "type": "object" }, "prediction": { "type": "string" },
        "postconditions": { "type": "object" }, "verifier": { "type": "string" }, "falsifier": { "type": "string" },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/RecordRef" } },
        "status": { "enum": ["waiting", "passed", "failed", "blocked", "runner_unavailable"] }, "recordedAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ProjectionPreferenceV1": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "preferenceId", "principalRef", "scopeRef", "viewKind", "fieldPath", "operation", "value", "status", "revision", "sourceEventRef", "createdAt", "updatedAt"],
      "properties": {
        "schemaVersion": { "const": "yawn.projection-preference.v1" }, "preferenceId": { "type": "string", "minLength": 1 },
        "principalRef": { "type": "string", "minLength": 1 },
        "scopeRef": {
          "type": "object", "additionalProperties": false, "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["principal", "agent_space", "arena", "yawn", "observation", "view"] },
            "id": { "type": "string", "minLength": 1, "maxLength": 500 },
            "revision": { "type": ["integer", "null"], "minimum": 0 },
            "stateSha256": { "anyOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] }
          }
        },
        "viewKind": { "type": "string", "minLength": 1 }, "fieldPath": { "type": "string", "pattern": "^/[A-Za-z0-9_.~/-]+$" },
        "operation": { "enum": ["set", "reset"] }, "value": {}, "status": { "const": "accepted" },
        "revision": { "type": "integer", "minimum": 1 }, "sourceEventRef": { "type": "string", "minLength": 1 },
        "createdAt": { "$ref": "#/$defs/Timestamp" }, "updatedAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "QuestionProposalV1": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "questionProposalId", "revision", "observationRef", "source", "text", "transformation", "proposedBy", "organization", "questionStatus", "proposalStatus", "createdAt"],
      "properties": {
        "schemaVersion": { "const": "yawn.question-proposal.v1" },
        "questionProposalId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "observationRef": {
          "allOf": [
            { "$ref": "#/$defs/RecordRef" },
            { "required": ["revision", "stateSha256"], "properties": { "kind": { "const": "observation" }, "revision": { "type": "integer", "minimum": 1 }, "stateSha256": { "$ref": "#/$defs/Sha256" } } }
          ]
        },
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["fieldPath", "verbatimText", "sourceSpanIndexes"],
          "properties": {
            "fieldPath": { "type": "string", "pattern": "^/remainsOpen/(0|[1-9][0-9]*)$" },
            "verbatimText": { "type": "string", "minLength": 1 },
            "sourceSpanIndexes": { "const": [] }
          }
        },
        "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "transformation": { "enum": ["verbatim", "organized"] },
        "proposedBy": { "allOf": [{ "$ref": "#/$defs/RecordRef" }, { "properties": { "kind": { "enum": ["actor", "principal"] } } }] },
        "organization": {
          "type": "object", "additionalProperties": false,
          "required": ["agentSpaceRef", "arenaRef", "aboutYawnRefs"],
          "properties": {
            "agentSpaceRef": { "allOf": [{ "$ref": "#/$defs/RecordRef" }, { "properties": { "kind": { "const": "agent_space" } } }] },
            "arenaRef": { "anyOf": [{ "allOf": [{ "$ref": "#/$defs/RecordRef" }, { "properties": { "kind": { "const": "arena" } } }] }, { "type": "null" }] },
            "aboutYawnRefs": { "type": "array", "uniqueItems": true, "items": { "allOf": [{ "$ref": "#/$defs/RecordRef" }, { "properties": { "kind": { "const": "yawn" } } }] } }
          }
        },
        "questionStatus": { "const": "open" },
        "proposalStatus": { "const": "proposed" },
        "createdAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ArtBriefV1": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "briefId", "revision", "observationRef", "questionProposalRef", "proposedBy", "visualIntention", "identityAsset", "textPolicy", "accessibleDescription", "semanticColorRoles", "compositionRequirements", "negativeConstraints", "render", "boundary", "proposalStatus", "createdAt"],
      "properties": {
        "schemaVersion": { "const": "yawn.art-brief.v1" },
        "briefId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "observationRef": {
          "allOf": [
            { "$ref": "#/$defs/RecordRef" },
            { "required": ["revision", "stateSha256"], "properties": { "kind": { "const": "observation" }, "revision": { "type": "integer", "minimum": 1 }, "stateSha256": { "$ref": "#/$defs/Sha256" } } }
          ]
        },
        "questionProposalRef": { "allOf": [{ "$ref": "#/$defs/RecordRef" }, { "required": ["revision", "stateSha256"], "properties": { "kind": { "const": "question_proposal" }, "revision": { "type": "integer", "minimum": 1 }, "stateSha256": { "$ref": "#/$defs/Sha256" } } }] },
        "proposedBy": { "allOf": [{ "$ref": "#/$defs/RecordRef" }, { "properties": { "kind": { "enum": ["actor", "principal"] } } }] },
        "visualIntention": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "identityAsset": {
          "type": "object", "additionalProperties": false,
          "required": ["recordRef", "sha256", "crop", "role"],
          "properties": {
            "recordRef": { "allOf": [{ "$ref": "#/$defs/RecordRef" }, { "properties": { "kind": { "const": "source" } } }] },
            "sha256": { "$ref": "#/$defs/Sha256" },
            "crop": { "enum": ["face_only", "full_body", "none"] },
            "role": { "const": "reflective_agent_not_authority" }
          }
        },
        "textPolicy": {
          "type": "object", "additionalProperties": false,
          "required": ["questionRenderedAsPixels", "liveTextRequired"],
          "properties": {
            "questionRenderedAsPixels": { "const": false },
            "liveTextRequired": { "const": true }
          }
        },
        "accessibleDescription": { "type": "string", "minLength": 1 },
        "semanticColorRoles": {
          "type": "object", "additionalProperties": false,
          "required": ["observation", "question", "agent"],
          "properties": {
            "observation": { "type": "string", "minLength": 1 },
            "question": { "type": "string", "minLength": 1 },
            "agent": { "type": "string", "minLength": 1 }
          }
        },
        "compositionRequirements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "negativeConstraints": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "render": {
          "type": "object", "additionalProperties": false,
          "required": ["width", "height", "seed", "maxCandidates"],
          "properties": {
            "width": { "type": "integer", "minimum": 64, "maximum": 4096 },
            "height": { "type": "integer", "minimum": 64, "maximum": 4096 },
            "seed": { "type": "integer", "minimum": 0 },
            "maxCandidates": { "const": 1 }
          }
        },
        "boundary": {
          "type": "object", "additionalProperties": false,
          "required": ["effectGrantRequired", "externalNetworkEgressAuthorized", "paidProviderCallAuthorized", "maximumPaidCostMicrousd", "canonicalMutationAuthorized", "publicationAuthorized", "promotionAuthorized"],
          "properties": {
            "effectGrantRequired": { "const": true },
            "externalNetworkEgressAuthorized": { "const": false },
            "paidProviderCallAuthorized": { "const": false },
            "maximumPaidCostMicrousd": { "const": 0 },
            "canonicalMutationAuthorized": { "const": false },
            "publicationAuthorized": { "const": false },
            "promotionAuthorized": { "const": false }
          }
        },
        "proposalStatus": { "const": "proposed" },
        "createdAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ProjectionFeedbackV1": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "feedbackId", "ontologyRole", "assertedBy", "source", "subjectRef", "expectedExperience", "actualProjectionEvidence", "divergenceDimensions", "preferenceUpdateProposals", "proofObligations", "epistemicStatus", "universality", "proposalStatus", "boundary", "createdAt"],
      "properties": {
        "schemaVersion": { "const": "yawn.projection-feedback.v1" },
        "feedbackId": { "type": "string", "minLength": 1 },
        "ontologyRole": { "const": "proposal_facet" },
        "assertedBy": { "allOf": [{ "$ref": "#/$defs/RecordRef" }, { "properties": { "kind": { "enum": ["actor", "principal"] } } }] },
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["coordinate", "coordinateKind", "platformMessageIdVerified", "exactQuote", "capturedAt"],
          "properties": {
            "coordinate": { "type": "string", "minLength": 1 },
            "coordinateKind": { "enum": ["local_handoff", "browser_capture", "synthetic_fixture"] },
            "platformMessageIdVerified": { "const": false },
            "exactQuote": { "type": "string", "minLength": 1 },
            "capturedAt": { "$ref": "#/$defs/Timestamp" }
          }
        },
        "subjectRef": { "allOf": [{ "$ref": "#/$defs/RecordRef" }, { "properties": { "kind": { "const": "view" } } }] },
        "expectedExperience": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["text", "assertedBy", "epistemicStatus"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "assertedBy": { "type": "string", "minLength": 1 },
              "epistemicStatus": { "const": "reported" }
            }
          }
        },
        "actualProjectionEvidence": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["description", "evidenceRef", "verificationStatus"],
            "properties": {
              "description": { "type": "string", "minLength": 1 },
              "evidenceRef": { "$ref": "#/$defs/RecordRef" },
              "verificationStatus": { "const": "reported_not_independently_verified" }
            }
          }
        },
        "divergenceDimensions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["testing_fidelity", "ontology_to_interface_fidelity", "source_to_projection_traceability", "accessible_question_fidelity", "visual_identity_fidelity", "iteration_memory"] }
        },
        "preferenceUpdateProposals": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["preferenceProposalId", "scopeRef", "viewKind", "fieldPath", "operation", "value", "status", "rationale", "sourceFeedbackId"],
            "properties": {
              "preferenceProposalId": { "type": "string", "minLength": 1 },
              "scopeRef": { "$ref": "#/$defs/RecordRef" },
              "viewKind": { "type": "string", "minLength": 1 },
              "fieldPath": { "type": "string", "pattern": "^/[A-Za-z0-9_.~/-]+$" },
              "operation": { "enum": ["set", "reset"] },
              "value": {},
              "status": { "const": "proposed" },
              "rationale": { "type": "string", "minLength": 1 },
              "sourceFeedbackId": { "type": "string", "minLength": 1 }
            }
          }
        },
        "proofObligations": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["obligationId", "preconditions", "prediction", "postconditions", "verifier", "falsifier", "status"],
            "properties": {
              "obligationId": { "type": "string", "minLength": 1 },
              "preconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "prediction": { "type": "string", "minLength": 1 },
              "postconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "verifier": { "type": "string", "minLength": 1 },
              "falsifier": { "type": "string", "minLength": 1 },
              "status": { "const": "waiting" }
            }
          }
        },
        "epistemicStatus": { "const": "reported" },
        "universality": { "const": "subjective_attributed_evaluation" },
        "proposalStatus": { "const": "proposed" },
        "boundary": {
          "type": "object", "additionalProperties": false,
          "required": ["canonicalMutationAuthorized", "automaticPreferenceApplicationAuthorized", "publicationAuthorized", "promotionAuthorized"],
          "properties": {
            "canonicalMutationAuthorized": { "const": false },
            "automaticPreferenceApplicationAuthorized": { "const": false },
            "publicationAuthorized": { "const": false },
            "promotionAuthorized": { "const": false }
          }
        },
        "createdAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "YawnEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "agentSpaceId", "yawnId", "streamKey", "revision", "eventType", "actorId", "proposalId", "payload", "previousStateSha256", "resultingStateSha256", "occurredAt"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" }, "agentSpaceId": { "$ref": "#/$defs/Uuid" }, "yawnId": { "anyOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] }, "streamKey": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 }, "eventType": { "type": "string" }, "actorId": { "type": "string" },
        "proposalId": { "anyOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] }, "payload": { "type": "object" },
        "previousStateSha256": { "anyOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] }, "resultingStateSha256": { "$ref": "#/$defs/Sha256" },
        "occurredAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ProofReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "yawnId", "preconditions", "prediction", "postconditions", "verifier", "falsifier", "sourceRefs", "status", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" }, "yawnId": { "$ref": "#/$defs/Uuid" }, "preconditions": { "type": "object" }, "prediction": { "type": "string" },
        "postconditions": { "type": "object" }, "verifier": { "type": "string" }, "falsifier": { "type": "string" }, "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/SourceSpan" } },
        "status": { "enum": ["waiting", "passed", "failed", "blocked"] }, "createdAt": { "$ref": "#/$defs/Timestamp" }
      }
    }
  },
  "properties": {
    "constitution": { "$ref": "#/$defs/YawnConstitutionV1" }
  }
}
