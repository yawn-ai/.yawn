id: fixtures/node
title: "protocol fixtures"
kind: contract-node
status: active-mixed
updated: 2026-08-28

purpose: "Hold executable examples for schema, reducer, holarchy, objective, and multi-principal invariants."

holds:
  - canonical-contracts.v1.json
  - optional-target-yawns.v1.json
  - multi-principal-family.v1.json
  - agency-holarchy.v0.2.json
  - dave-good-dad-objective-holon.v0.1.json
  - orientation-map.v0.1.json
  - inquiry-selection-receipt.v0.1.json
  - interaction-operator-receipt.v0.1.json

coverage:
  - versioned canonical interfaces
  - deterministic replay
  - unauthorized-event exclusion
  - targets optional for Source, Inquiry, Archive, and Relationship yawns
  - maintain, prevent, and hold-open target modes
  - separately authored desires and privacy
  - ratification, recurring commitment, authorization, proof, and reconciliation
  - nested Yawns with one primary parent and typed relations
  - asynchronous waiting, resume conditions, causal events, and transitions
  - routing hard gates and authorized structural-change receipts
  - typed objective detection, ratification, sleeping bot binding, and explicit activation
  - nine-axis orientation coverage, deterministic inquiry rank, and presentation/semantic separation
  - replayable selected-question and explicit-hold inquiry receipts with typed provenance
  - source-bound interaction operators that cannot grant authority or collapse review into ratification

proof:
  command: "npm test"
  status: executable
