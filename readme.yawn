# Root orientation record for the repository.
# README.md is the human landing page; this file dogfoods the protocol.

spec_version: "0.2-draft"
id: yawn:repository:ontology-hub
title: ".yawn ontology hub"
kind: yawn
status: active
revision: 4
updated: "2026-08-16"

identity:
  repository: "https://github.com/yawn-ai/.yawn"
  live_hub: "https://yawn-ai.github.io/.yawn/"
  license: MIT
  copyright_holder: "The Yawn Company"
  human_front_door: README.md
  repository_manifest: yawn.yawn

signal:
  raw: >
    Observation now has an executable identity, replay, proof subject,
    serializer, and View-preference boundary. The next gap is preserving exact
    lineage when an open question is organized, expressed through local art,
    evaluated as a projection, and returned as actionable feedback.
  epistemic_status: observed
  source_refs:
    - README.md@before-ontology-hub
    - contracts/schemas/yawn-contracts-v1.schema.json
    - schemas/node.yawn
    - interface/new-yawn-v0.1.yawn

orientation:
  current_state:
    - claim: "The contracts package and state substrate are parallel v1 modules."
      epistemic_status: observed
      source_refs:
        - contracts/schemas/yawn-contracts-v1.schema.json
        - schemas/state-snapshot.v1.schema.json
    - claim: "The human full template is not validated by either v1 module."
      epistemic_status: observed
      source_refs:
        - templates/full.yawn
    - claim: "The numbered .ion generation remains as a historical bridge."
      epistemic_status: observed
      source_refs:
        - 00-start/root.ion
        - 08-research/source-index.ion
    - claim: "Agent Arena is best treated as one View over a neutral causal graph."
      epistemic_status: inferred
      source_refs:
        - docs/projections/README.md
    - claim: "Observation is a first-class record and does not require Yawn promotion."
      epistemic_status: observed
      source_refs:
        - schemas/observation.v1.schema.json
        - fixtures/observation.v1.json
        - lib/observation-state-v1.mjs
    - claim: ".yawn, YAWN.bot, and YAWN.ai have record, interface/agent, and intelligence roles around one grammar."
      epistemic_status: reported
      source_refs:
        - README.md
    - claim: "An Observation-derived Question, Art Brief, local candidate, and Projection feedback remain separately attributable proposals."
      epistemic_status: observed
      source_refs:
        - schemas/question-proposal.v1.schema.json
        - schemas/art-brief.v1.schema.json
        - schemas/local-art-candidate.v1.schema.json
        - schemas/projection-feedback.v1.schema.json
        - fixtures/observation-question-art.v1.json

  governing_inference: >
    The repository serves as the ontology hub when it starts with Observation,
    separates source from inference, makes accepted records replayable, and
    keeps Views, authority, preference, and optional Yawn promotion explicit.
  epistemic_status: inferred
  alternatives:
    - "Collapse every artifact into one schema immediately."
    - "Leave the generations separate and rely on readers to infer the mapping."
  rejected_alternatives:
    - alternative: "Collapse every artifact into one schema immediately."
      reason: "It would silently rewrite merged v1 compatibility surfaces."
    - alternative: "Leave the mapping implicit."
      reason: "It reproduces the hidden-inference problem YAWN is meant to expose."

arena:
  ref: arena:repository:ontology-hub
  purpose: "Publish and evolve a coherent, inspectable agency protocol."
  participants:
    - agent: "agent:david-forman"
      roles: [founding-maintainer, steward, affected]
    - agent: "agent:open-source-contributor"
      roles: [proposer, reviewer]
    - agent: "agent:software-system"
      roles: [operational-proposer]
  inclusions:
    - public protocol contracts
    - source-attributed examples and fixtures
    - public research and design rationale
    - governance and conformance evidence
  exclusions:
    - private user memory
    - credentials and proprietary runtime state
    - claims that the schema exhausts reality
  constraints:
    - preserve merged v1 contracts
    - preserve public history and provenance
    - keep AI authority proposal-only
    - require proof before stable claims
  frame_limits:
    - field calibration for merge and split thresholds remains incomplete
    - independent implementations have not yet established interoperability

lacuna:
  primary: >
    The human document, runtime constitution, state modules, and projection
    grammar do not yet share one unified versioned serialization.
  open_questions:
    - "What is the smallest compatible aggregate envelope?"
    - "Which arena-routing thresholds survive real human review?"
    - "How should privacy-preserving conversation import prove source coverage?"
    - "Which parts of Draft 0.2 should enter the next stable contract?"

intent:
  mode: coordinate
  target_condition: >
    A public visitor and an implementation agent can locate the relevant
    definition, authority boundary, schema, example, and proof without treating
    a projection or historical file as canonical state.
  ratification_status: proposed

boundaries:
  must_not:
    - turn desire into authorization
    - turn confidence into permission
    - let a move verify itself
    - fabricate skipped orientation answers
    - disclose private context through parent-child inheritance
    - use embeddings or coordinates to decide identity
    - call the working draft a complete stable protocol
    - delete history to create the appearance of coherence
  AI_default:
    may: [observe, ask, summarize, propose, test-within-grant]
    may_not: [self-authorize, silently-publish, widen-permissions, erase-provenance]

move:
  description: >
    Maintain one concise human README, a live root landing page, an explicit
    layered specification, additive Draft 0.2 schemas and tests, commented
    templates, decisive examples, a first-class Observation record, and an
    Observation-to-question-to-art proposal chain with an honest open-source
    governance surface.
  reversible: true
  authority_status: proposed-until-maintainer-merge

proof_contract:
  preconditions:
    - "Existing v1 fixtures and generated types pass unchanged."
    - "The draft is labeled and does not claim stable compatibility."
  acceptance:
    - "Root npm test passes."
    - "contracts npm run check and npm pack --dry-run pass."
    - "Observation fixture, event replay, serializer, and golden hash agree."
    - "Question and Art Brief hashes bind to the exact Observation and source wording."
    - "Unverified local candidates cannot pass reviewability or authorize publication."
    - "Internal links on the public hub resolve."
    - "The GitHub Pages root returns the new ontology hub after merge."
    - "Feedback and Declaration routes remain live."
  falsifiers:
    - "An existing v1 fixture changes meaning or fails."
    - "The hub implies world equals arena or arena equals Yawn."
    - "A projection can mutate semantic state or permissions."
    - "A structural change can erase source identity or bypass authority."

protocol_layers:
  stable_constitution:
    path: contracts/
    version: "1.0.0"
  stable_state_substrate:
    path: schemas/
    version: "1"
    kinds:
      - state_snapshot
      - event
      - desire
      - target_condition
      - transition_intent
      - transition_result
      - state_update
  agency_holarchy:
    path: schemas/agency-holarchy.v0.2.schema.json
    version: "0.2-draft"
    stability: experimental
  human_document:
    paths: [templates/, examples/]
    stability: mixed-and-explicitly-versioned
  projections:
    path: docs/projections/
    canonical_state: false
  observation_record:
    schema: schemas/observation.v1.schema.json
    reducer: lib/observation-state-v1.mjs
    template: templates/observation.yawn
    valid_without_yawn_promotion: true
  observation_question_art:
    question_schema: schemas/question-proposal.v1.schema.json
    brief_schema: schemas/art-brief.v1.schema.json
    candidate_schema: schemas/local-art-candidate.v1.schema.json
    feedback_schema: schemas/projection-feedback.v1.schema.json
    interface_contract: interface/local-observation-art-v0.1.yawn
    canonical_state: false
    automatic_acceptance_publish_or_promotion: false

ontology_links:
  specification: spec/README.md
  ontology: spec/ontology.md
  holarchy: spec/holarchy.md
  turns: spec/turns.md
  routing: spec/routing.md
  questions: spec/questions.md
  serialization: spec/serialization.md
  world_field_arena: core/world-field-arena.yawn
  holarchy_contract: core/holarchy.yawn
  turn_contract: core/turn.yawn
  routing_contract: core/routing.yawn
  projection_boundary: core/projection-and-aperture.yawn
  observation_contract: schemas/observation.v1.schema.json
  record_reference: schemas/record-ref.v1.schema.json
  projection_preference: schemas/projection-preference.v1.schema.json
  observation_question_art: interface/local-observation-art-v0.1.yawn

practice_links:
  quickstart: docs/quickstart.md
  templates:
    - templates/basic.yawn
    - templates/full.yawn
    - templates/arena.yawn
    - templates/turn.yawn
    - templates/routing-proposal.yawn
    - templates/structural-change-receipt.yawn
    - templates/observation-question-art.yawn
  examples:
    - examples/nested-agent-arena.yawn
    - examples/waiting-turn.yawn
    - examples/conversation-import-routing.yawn
    - examples/merge-split-routing.yawn

project_links:
  documentation: docs/README.md
  status: docs/project-status.md
  roadmap: ROADMAP.md
  contributing: CONTRIBUTING.md
  governance: GOVERNANCE.md
  security: SECURITY.md
  changelog: CHANGELOG.md
  citation: CITATION.cff
  declaration_of_agency: agency-declaration/index.html
  q_space: q-space/node.yawn

replay:
  current_claim: >
    README.md is the human front door, readme.yawn is the repository's own
    orientation object, yawn.yawn is the machine-addressable manifest, and
    Observation is the first executable entry into the ontology. Open Question,
    Art Brief, candidate, and feedback records preserve its source while
    remaining proposal-only around it.
  next_review_when:
    - Draft 0.2 has field routing evidence
    - a unified document RFC is proposed
    - an independent implementation reports a compatibility gap
