  orientation: core/orientation.yawn
  full_shape: templates/orientation-shape.yawn

boundary:
  - "Do not invent location, context, history, identity, or permission."
  - "A coordinate describes a viewpoint; it does not grant authority."
  - "Human expression, machine inference, and shared orientation remain distinct."
  - "An entire orientation is not proved; specific claims may be verified or contested."
