  description: >
    13 judgments sit at explicit-typed-absence (4 authored) and 1 at silent-blank
    (0 authored). The repository asserts both directions on this axis.
  attributed_to: JUDGMENTS.md
  epistemic_status: observed
  source_refs:
    - JUDGMENTS.md
    - TAXONOMY.md

lacuna:
  kind: unselected_choice
  description: >
    The full proposal.

options:
  - name: A
    description: >
      explicit typed absence becomes the stated rule across its scope.
    cost: "not yet drafted"
    risk: "not yet drafted"
    reversibility: true
    proof_needed: "not yet drafted"
    evidence_for:
