      - "J0740"
  - name: B
    description: >
      silent blank becomes the stated rule across its scope.
    cost: "not yet drafted"
    risk: "not yet drafted"
    reversibility: true
    proof_needed: "not yet drafted"
    evidence_for:
      - "J0116"
  - name: C
