  description: >
    12 judgments sit at multi-axis-status (8 authored) and 4 at
    single-scalar-status (0 authored). The repository asserts both directions on
    this axis.
  attributed_to: JUDGMENTS.md
  epistemic_status: observed
  source_refs:
    - JUDGMENTS.md
    - TAXONOMY.md

lacuna:
  kind: unselected_choice
  description: >
    The full proposal.

options:
