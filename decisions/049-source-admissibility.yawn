    risk: "not yet drafted"
    reversibility: true
    proof_needed: "not yet drafted"
    evidence_for:
      - "J0352"
  - name: B
    description: >
      repo internal source becomes the stated rule across its scope.
    cost: "not yet drafted"
    risk: "not yet drafted"
