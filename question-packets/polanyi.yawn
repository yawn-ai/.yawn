proof:
  covers:
    - questions
    - seal_rule
  validator: scripts/validate-articulation-floor-v0.1.mjs
  tests:
    - tests/articulation-floor-v0.1.test.mjs
  condition: >
    Every axis carries a seal whose hash recomputes from its sealed fields and
    whose t_sealed is a valid UTC timestamp; the validator exits 1 otherwise.
  not_covered:
    - "whether any reader has marked an axis; that lives in answer records"
    - "whether Polanyi's marks are the right reading of the sources"
  status: contract-defined
