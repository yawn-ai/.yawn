# yawn-invalid-alias-guard:start
spec_version: "0.2-draft"
id: "yawn:migration:canonical-extension:2026-08-17"
title: "Canonicalize YAWN naming and retire invalid extension aliases"
kind: "migration-receipt"
status: "proposed"
revision: 1
updated: "2026-08-17"

decision:
  canonical_product_name: "YAWN"
  canonical_extension: ".yawn"
  invalid_schema_aliases: [".ion", ".yon"]
  invalid_product_aliases: ["ION", "Yon"]
  reason: >-
    The invalid aliases repeatedly arise from speech-to-text and model
    transcription. The repository also retained a numbered legacy .ion
    generation, which taught the same mistake to later agents. YAWN now
    maintains one product name and one portable record extension.

scope:
  source_commit: "8964da1db52f67459c80944fba5f369d96574247"
  source_tree: "e38c9364ebb5479783e437872ecbd1d5b7efdae3"
  source_repository: "https://github.com/yawn-ai/.yawn"
  invalid_extension_files_removed: 50
  legacy_roots_retired:
    - "00-start"
    - "01-core"
    - "02-interface"
    - "03-filesystem"
    - "04-agent"
    - "05-proof"
    - "06-product"
    - "07-templates"
    - "08-research"

migration_method:
  strategy: "semantic-absorption"
  rules:
    - >-
      Do not mechanically rename a historical file and thereby make stale
      terminology appear canonical.
    - >-
      Preserve every removed source at the immutable source commit and map its
      surviving claims to one or more current .yawn/spec/schema records.
    - >-
      If a historical detail is not represented by a current target, it remains
      historical evidence until a maintainer deliberately restates and proves it.
    - >-
      No invalid-extension source is accepted as active schema, authority, or proof.

history_preservation:
  git_history_preserved: true
  source_paths_preserved_in_this_receipt: true
  raw_claims_promoted_automatically: false
  rollback: >-
    Read the named path at the immutable source commit. Restoration requires a
    new .yawn migration proposal; the invalid extension must not be restored.

speech_to_text_boundary:
  contract: "core/canonical-extension.yawn"
  raw_transcript_preserved: true
  context_required: true
  ambiguity_behavior: "hold creation and surface one naming question"
  explicit_non_yawn_examples:
    - "a chemical ion"
    - "a person genuinely named Yon"

absorption_map:
  - legacy_path: "00-start/root.ion"
    disposition: "absorbed-or-superseded"
    canonical_targets:
      - "readme.yawn"
      - "yawn.yawn"
  - legacy_path: "00-start/value-proposition.ion"
    disposition: "absorbed-or-superseded"
    canonical_targets:
      - "start/value-proposition.yawn"
  - legacy_path: "00-start/what-is-an-ion.ion"
    disposition: "absorbed-or-superseded"
    canonical_targets:
