proof_contract:
  validator: "scripts/validate-canonical-extension.mjs"
  normalizer: "lib/canonical-extension-v1.mjs"
  tests: "tests/canonical-extension-v1.test.mjs"
  acceptance:
    - "No tracked path ends with .ion or .yon."
    - "No active source defines ION or Yon as a YAWN schema or product."
    - "All 50 removed paths appear exactly once in this receipt."
    - "Common speech substitutions normalize only after YAWN context is established."
    - "Raw transcript and correction provenance remain inspectable."
  falsifiers:
    - "A new invalid-extension artifact can enter the tracked tree without CI failure."
    - "Normalization changes an unrelated chemical or personal-name use."
    - "The migration silently promotes an old claim not present in a current target."

authority:
  proposed_by: "OpenAI agent acting under Dave's explicit instruction"
  merge_authority: "Dave / repository maintainer"
  production_effect: false

replay:
  before: >-
    The repository publicly described .yawn as canonical while retaining 50
    active tracked .ion files and source references to them.
  after: >-
    The active tree has one extension, one lexical contract, one migration
    receipt, deterministic speech normalization, and a fail-closed validator.
# yawn-invalid-alias-guard:end
