id: examples/cold-start-agent
title: "context-free agent enters .yawn"
kind: conformance-fixture
status: active
updated: 2026-07-11

given:
  chat_context: none
  entry_file: yawn.yawn

expected_orientation:
  repository: https://github.com/yawn-ai/.yawn
  repository_role: public coherence protocol
  canonical_human_root: readme.yawn
  universal_loop: core/co-orientation-loop.yawn
  official_runtime:
    identity: YAWN.bot
    repository: https://github.com/yawn-ai/web-game
    status: official
  human_doorway: questions/node.yawn
  unresolved_questions: questions/open-questions.yawn
  runtime_identity: agents/yawn.bot.yawn
  bounded_contributor_module: agents/repo-contributor.yawn
  promotion_receipt: records/yawn-bot-runtime-promotion-2026-07-11.yawn

expected_answer:
  what_am_i_inside: "the public .yawn coherence protocol repository"
  where_am_i: "the root protocol coordinate"
  what_is_official_runtime: "YAWN.bot at yawn-ai/web-game"
  what_is_inferred: "anything not established by source or accepted receipt"
  what_is_open: "the live entries in questions/open-questions.yawn"
  what_may_i_do: "read, orient, ask, and prepare local reviewable proposals"
  what_must_i_not_do: "silently mutate, publish, disclose, spend, or raise authority"

proof_command: "powershell -ExecutionPolicy Bypass -File scripts/verify-cold-start.ps1"
