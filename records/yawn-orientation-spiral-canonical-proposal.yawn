observer:
  principals:
  - id: actor:dave
    kind: human
    authority:
    - meaning
    - identity
    - values
    - consent
    - irreversible_decisions
  - id: agent:chatgpt-current
    kind: software_agent
    authority:
    - research
    - synthesis
    - proposal
    advisory_only: true
  distinctions:
  - experience_is_not_interpretation
  - observation_is_not_objective_truth
  - AI_inference_is_not_Dave_statement
  - capability_is_not_authority
  - view_is_not_canonical_state
  - intention_is_not_projection
  - projection_is_not_consequence
current_state:
  summary: YAWN has an open protocol, canonical operational substrate, semantic View, public orientation language,
    and multiple graph interfaces, but the public experience does not yet render one recursive observation-orientation-relationship
    spiral from one shared snapshot.
  evidence:
  - The .yawn repository defines signal -> orientation -> choice -> move -> proof -> update.
  - YAWN.ai merged an orientation front door and authenticated Dave semantic View.
  - YAWN.bot built the canonical Dave homebase and global QR-capable chrome.
  - The two applications do not yet share a permanent public interface/export contract or deterministic spiral View.
observations:
- id: observation://dave/recursive-exposure
  acquired_by: actor:dave
  arena: arena://chatgpt/current/orientation-spiral-discovery
  acquired_refs:
  - statement://dave/recursive-exposure
  conditions: direct participation in the conversation
  limits: the other intelligence's internal state is not directly available
- id: observation://system/spiral
  acquired_by: agent:chatgpt-current
  arena: arena://chatgpt/current/orientation-spiral-discovery
  acquired_refs:
  - statement://system/spiral
  conditions: source-bundle and repository review
  limits: synthesis remains proposal-only pending owner review
- id: observation://system/lacuna-center
  acquired_by: agent:chatgpt-current
  arena: arena://repository/public-interface
  acquired_refs:
  - statement://system/lacuna-center
  conditions: interface-contract audit
  limits: design proposal, not canonical product state
statements:
- id: statement://dave/recursive-exposure
  asserted_by: actor:dave
  body: An observer can expose the process by which another intelligence is observing and interpreting, causing the next response to adapt.
  epistemic_status: user_reported_and_interaction_observed
- id: statement://system/spiral
  asserted_by: agent:chatgpt-current
  body: Observation, orientation, and relationship recur as product-facing lenses, while Intention, Projection, Move, Consequence, Proof, and Update are required for closure.
  epistemic_status: inferred
  requires_owner_review: true
- id: statement://system/lacuna-center
  asserted_by: agent:chatgpt-current
  body: The active Yawn or consequential lacuna should be central; YAWN.bot should be a participant and overlay.
  epistemic_status: research_supported_design_proposal
  requires_owner_review: true
proposed_model:
  public_name: The Orientation Spiral
  primary_lenses:
  - observation
  - orientation
  - relationship
  closure:
  - intention
  - authority_boundary
  - projection
  - move_when_selected
  - consequence
  - proof
  - update
  - observation_again
  expression: observe -> orient -> relate -> intend -> project -> move when selected -> consequence/proof -> observe again
  relation_to_canonical_loop: derived_human_view_not_fourth_canonical_loop
ontology_extensions:
  recursive_observation:
    rule: Observation is an attributed acquisition event and may acquire a statement, event, prior Observation, Projection, Consequence, relationship state, policy, or proof.
    recursion_depth: derived_from_observes_edges
    consciousness_claim: none
  relationship:
    generic: typed edge
    promote_to_yawn_when:
    - substantive mutual state
    - participants
    - shared referent
    - consent
    - commitments_or_tensions
    - history
    - proof_update_loop
  intention: selected or endorsed direction that may never be projected
  projection: what an Agent actually expresses, represents, proposes, commits, or attempts back into an Arena
  move: the action-bearing subset of Projection; every Move is a Projection, not every Projection is a Move
  consequence: what the Arena and reality return, distinct from intention, prediction, and Projection
  view: non-authoritative rendering or export carrying canonical ref and snapshot hash
  arena: bounded task-relevant participant/context slice; not identical to mental model
  agent: participant capable of sensing/acting; consciousness not implied
interface:
  persistent_header:
  - coordinate
  - context_action
  - action_reason
  - bot_overlay
  - download_yawn
  - qr
  - github_protocol
  - account_optional
  github_protocol: https://github.com/yawn-ai/.yawn
  theme:
    id: yawn-64
    status: pending_reference
  spiral:
    center: active_yawn_or_lacuna
    parent: red_upward_node
    visible_nodes: orange
    geometry: deterministic_golden_spiral_plus_bounded_force_collision
    bot_overlay: same_node_ids_same_snapshot
routes:
- path: /
  purpose: live orientation spiral entry
- path: /bot
  purpose: agent overlay and authority explainer
- path: /observation
  purpose: recursive observation demonstration
- path: /orientation-spiral
  purpose: canonical conceptual explainer
- path: /trifecta
  purpose: experimental alias
- path: /dave
  purpose: public Dave relationship offer
- path: /2026/dave/being-40
  purpose: situated proof-backed personal View
- path: /2026/dave/kindergarten
  purpose: candidate relational spiral demonstration
- path: /2026/dave/yawn-explainer
  purpose: canonical explainer media View
- path: /dave/wording
  purpose: canonical wording child Yawn; resolve from state, do not fabricate
decisions:
- id: decision://use-existing-protocol
  status: proposed
  statement: Extend yawn-ai/.yawn; do not create a competing ontology.
- id: decision://one-state-many-views
  status: proposed
  statement: YAWN.ai, YAWN.bot, download, QR, and media derive from one canonical snapshot.
- id: decision://public-dave-first
  status: proposed
  statement: Implement public /dave plus /2026/dave/being-40 as the first vertical slice.
- id: decision://reuse-d3
  status: proposed
  statement: Use existing D3/Canvas graph for the first public spiral; keep React Flow/ELK as owner workbench.
- id: decision://style-as-skin
  status: proposed
  statement: Treat YAWN 64-bit as a replaceable theme pending reference.
authority:
  allowed_without_new_external_approval:
  - research
  - documentation
  - local_validation
  - proposal_generation
  requires_dave_approval:
  - public_wording_as_Dave
  - video_publication
  - relationship_activation
  - schema_promotion
  - merge
  - deployment
  - public_private_reclassification
boundaries:
- No new canonical state store.
- No inference promoted to Dave testimony.
- No relationship presumed from a page visit.
- No bot placed at the ontological center.
- No private source body in public export.
- No package removal without usage and build proof.
- No final 64-bit art direction before reference review.
- No action authorized by capability alone.
- No Intention treated as an actual Projection.
- No Projection treated as its received meaning or Consequence.
proposal_projection:
  id: projection://public-dave-spiral-vertical
  kind: proposal
  intention: intention://make-public-orientation-inspectable
  proposes_move: move://public-dave-spiral-vertical
  status: produced
proposed_move:
  id: move://public-dave-spiral-vertical
  title: Ship one public-safe Dave relationship and Orientation Spiral vertical slice
  outputs:
  - public /dave
  - /2026/dave/being-40
  - shared permanent header
  - public-safe .yawn export
  - deterministic spiral
  - YAWN.bot overlay
  - snapshot hash equality proof
proof:
  acceptance:
  - Signed-out /dave is public and uses existing Dave image.
  - Visitor can state what Dave asks and offers.
  - Relationship remains offer until participation/consent.
  - Header exposes action reason, download, QR, GitHub, bot toggle.
  - YAWN.ai/YAWN.bot/download share snapshot hash.
  - No private source body leaks.
  - Reduced motion and semantic fallback pass.
  - Response becomes proposal and Dave retains approval.
  falsifiers:
  - Spiral becomes a second state system.
  - Bot overlay changes node identity.
  - Downloaded file differs semantically from visible page.
  - Public relationship page implies visitor consent.
  - Interface cannot explain why its primary action is shown.
  - Visual treatment obscures source/authority/proof.
unresolved:
- id: unknown://yawn-64-reference
  owner: actor:dave
  status: awaiting_reference
- id: unknown://dave-image-final-crop
  status: requires_visual_review
- id: unknown://dave-wording-canonical-object
  status: resolve_from_canonical_state
- id: unknown://final-explainer-recording
  status: awaiting_source_or_authorization
- id: unknown://triad-final-name
  status: test_observe_orient_relate_vs_observation_orientation_relationship
