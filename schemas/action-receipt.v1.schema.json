{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yawn.ai/schemas/action-receipt.v1.schema.json",
  "title": "YAWN Action Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "relationshipRef", "requestRef", "batchEntryRef", "effectSignature", "actorRef", "approvalBasis", "observedHeadSha", "outcome", "proof", "sourceRefs", "startedAt", "occurredAt"],
  "properties": {
    "schemaVersion": { "const": "yawn.action-receipt.v1" },
    "receiptId": { "type": "string", "minLength": 1, "maxLength": 500 },
    "relationshipRef": { "$ref": "record-ref.v1.schema.json" },
    "requestRef": { "$ref": "record-ref.v1.schema.json" },
    "batchEntryRef": { "anyOf": [{ "$ref": "record-ref.v1.schema.json" }, { "type": "null" }] },
    "effectSignature": { "$ref": "action-signature.v1.schema.json" },
    "actorRef": { "$ref": "record-ref.v1.schema.json" },
    "approvalBasis": { "type": "string", "minLength": 1, "maxLength": 500 },
    "observedHeadSha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
    "outcome": { "enum": ["succeeded", "failed", "blocked", "stale", "skipped"] },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preconditions", "prediction", "postconditions", "verifier", "falsifier", "checks"],
      "properties": {
        "preconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "prediction": { "type": "string", "minLength": 1 },
        "postconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "verifier": { "type": "string", "minLength": 1 },
        "falsifier": { "type": "string", "minLength": 1 },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "status", "evidence"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "status": { "enum": ["passed", "failed", "blocked", "not_applicable"] },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "record-ref.v1.schema.json" } },
    "startedAt": { "type": "string", "format": "date-time" },
    "occurredAt": { "type": "string", "format": "date-time" }
  }
}
