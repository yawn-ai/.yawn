{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yawn.ai/schemas/protocol-manifest.v0.1.schema.json",
  "title": "YAWN Protocol Manifest V0.1",
  "description": "A commit-independent, content-addressed module set and conformance-profile manifest for additive YAWN protocol consumption. artifactSetSha256 is artifact integrity, not profile identity; downstream claims pin the detached whole-manifest SHA-256 together with profileId.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "protocolRevision",
    "compatibilityMode",
    "hashAlgorithm",
    "artifactSetCanonicalization",
    "artifactSetSha256",
    "modules",
    "conformanceProfiles",
    "extensions"
  ],
  "properties": {
    "$schema": { "const": "./schemas/protocol-manifest.v0.1.schema.json" },
    "schemaVersion": { "const": "yawn.protocol-manifest.v0.1" },
    "protocolRevision": {
      "type": "string",
      "pattern": "^yawn\\.protocol\\.[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])\\.[1-9][0-9]*$"
    },
    "compatibilityMode": { "const": "additive" },
    "hashAlgorithm": { "const": "sha256" },
    "artifactSetCanonicalization": {
      "const": "utf8-json-stringify-lexicographically-sorted-tuples:[moduleId,version,path,role,sha256];no-whitespace;no-trailing-newline",
      "description": "Build one five-string tuple per artifact, sort tuples by their JSON serialization using Unicode code-unit order, serialize the complete tuple array with JSON.stringify, encode as UTF-8 with no trailing newline, and hash those exact bytes with SHA-256."
    },
    "artifactSetSha256": {
      "$ref": "#/$defs/Sha256",
      "description": "Integrity of canonical artifact tuples only. It excludes profile membership and MUST NOT be used alone as profile identity."
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Module" }
    },
    "conformanceProfiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ConformanceProfile" },
      "contains": {
        "type": "object",
        "properties": { "profileId": { "const": "yawn.bot/new.v0.1" } },
        "required": ["profileId"]
      }
    },
    "extensions": { "$ref": "#/$defs/ExtensionBag" }
  },
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "PortablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "ExtensionBag": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+(?:/[A-Za-z0-9._~-]+)?$"
      },
      "additionalProperties": true
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "sha256"],
      "properties": {
        "path": {
          "allOf": [
            { "$ref": "#/$defs/PortablePath" },
            { "not": { "const": "protocol-manifest.v0.1.json" } }
          ]
        },
        "role": {
          "enum": [
            "normative_contract",
            "executable_schema",
            "reference_runtime",
            "interface_contract",
            "semantic_packet",
            "authoring_template",
            "verification_cli",
            "conformance_fixture"
          ]
        },
        "sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "Module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "version", "stability", "artifacts"],
      "properties": {
        "moduleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"
        },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "stability": { "enum": ["stable", "working_draft"] },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Artifact" }
        }
      }
    },
    "Invariant": {
      "enum": [
        "observation_valid_without_promotion",
        "orientation_map_is_noncanonical_view",
        "confirmation_is_not_authority",
        "objective_ratification_is_not_bot_activation",
        "activation_is_not_effect_authority",
        "view_yawn_and_yawn_bot_are_distinct",
        "objective_materialization_requires_cross_document_resolution",
        "interaction_receipt_application_requires_resolution",
        "source_evidence_uses_constitutional_source_identity",
        "objective_bot_binding_receipt_required"
      ]
    },
    "ConformanceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "status",
        "description",
        "requiredModuleIds",
        "requiredArtifactPaths",
        "invariants"
      ],
      "properties": {
        "profileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "status": { "enum": ["working_draft", "active", "deprecated"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
        "requiredModuleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "requiredArtifactPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/PortablePath" }
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Invariant" }
        }
      }
    }
  }
}
