{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yawn.ai/schemas/relation-address.v0.1.schema.json",
  "title": "YAWN Relation Address V0.1",
  "description": "A directional View over one or more typed relation steps. The slash is a traversal handle; it is not the Relationship record itself and does not prove containment, consent, authority, or identity.",
  "$comment": "An address may enter one stable Relationship from different standpoints. primary_parent is reserved for an explicitly identified StructuralRelation step.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "addressId",
    "anchorRef",
    "displayPath",
    "portState",
    "targetAbsence",
    "steps",
    "standpointRef",
    "foregroundRelationshipRef",
    "foregroundQuestionRef",
    "viewCoordinates",
    "sourceRefs",
    "status",
    "createdAt",
    "updatedAt",
    "boundary",
    "extensions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "yawn.relation-address.v0.1"
    },
    "addressId": {
      "$ref": "#/$defs/Identifier"
    },
    "anchorRef": {
      "$ref": "#/$defs/Identifier"
    },
    "displayPath": {
      "$ref": "#/$defs/Path"
    },
    "portState": {
      "enum": [
        "open",
        "bound",
        "engaged"
      ]
    },
    "targetAbsence": {
      "anyOf": [
        {
          "enum": [
            "intentional_unbound",
            "unknown",
            "withheld",
            "not_applicable",
            "invalid"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Step"
      }
    },
    "standpointRef": {
      "$ref": "#/$defs/Identifier"
    },
    "foregroundRelationshipRef": {
      "$ref": "#/$defs/NullableIdentifier"
    },
    "foregroundQuestionRef": {
      "$ref": "#/$defs/NullableIdentifier"
    },
    "viewCoordinates": {
      "$ref": "#/$defs/ViewCoordinates"
    },
    "sourceRefs": {
      "allOf": [
        {
          "$ref": "#/$defs/References"
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "accepted_view",
        "superseded",
        "retired"
      ]
    },
    "createdAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "boundary": {
      "$ref": "#/$defs/AddressBoundary"
    },
    "extensions": {
      "$ref": "#/$defs/ExtensionBag"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "portState": {
            "const": "open"
          }
        },
        "required": [
          "portState"
        ]
      },
      "then": {
        "properties": {
          "targetAbsence": {
            "const": "intentional_unbound"
          },
          "steps": {
            "type": "array",
            "maxItems": 0
          },
          "foregroundRelationshipRef": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "portState": {
            "enum": [
              "bound",
              "engaged"
            ]
          }
        },
        "required": [
          "portState"
        ]
      },
      "then": {
        "properties": {
          "targetAbsence": {
            "type": "null"
          },
          "steps": {
            "type": "array",
            "minItems": 1
          },
          "foregroundRelationshipRef": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "NullableIdentifier": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "References": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Identifier"
      }
    },
    "Path": {
      "type": "string",
      "pattern": "^[^/\\\\\\s]+(?:/[^/\\\\\\s]+)*/?$"
    },
    "ViewCoordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aperture",
        "resolution",
        "time",
        "scope"
      ],
      "properties": {
        "aperture": {
          "enum": [
            "purpose",
            "model",
            "perspectives",
            "sources",
            "boundaries",
            "history",
            "frontier",
            "other"
          ]
        },
        "resolution": {
          "enum": [
            "glance",
            "standard",
            "deep"
          ]
        },
        "time": {
          "enum": [
            "now",
            "revision",
            "replay"
          ]
        },
        "scope": {
          "enum": [
            "relationship",
            "permitted_neighborhood"
          ]
        }
      }
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "fromRef",
        "toRef",
        "relationRecordRef",
        "relationRecordKind",
        "relationType",
        "direction",
        "roleBindings",
        "arenaRef",
        "mediationRefs",
        "apertureRef",
        "effectiveAt",
        "sourceRefs",
        "epistemicStatus",
        "semanticParentage"
      ],
      "properties": {
        "stepId": {
          "$ref": "#/$defs/Identifier"
        },
        "fromRef": {
          "$ref": "#/$defs/Identifier"
        },
        "toRef": {
          "$ref": "#/$defs/Identifier"
        },
        "relationRecordRef": {
          "$ref": "#/$defs/Identifier"
        },
        "relationRecordKind": {
          "enum": [
            "relationship",
            "structural_relation"
          ]
        },
        "relationType": {
          "enum": [
            "primary_parent",
            "relates_to",
            "holds_model_of",
            "observes",
            "participates_in",
            "affected_by",
            "references",
            "created",
            "questions",
            "projects",
            "delegates_to",
            "shares_with",
            "coordinates_with",
            "depends_on",
            "supports",
            "conflicts_with",
            "derived_from",
            "other"
          ]
        },
        "direction": {
          "enum": [
            "forward",
            "inverse"
          ]
        },
        "roleBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/RoleBinding"
          }
        },
        "arenaRef": {
          "$ref": "#/$defs/NullableIdentifier"
        },
        "mediationRefs": {
          "$ref": "#/$defs/References"
        },
        "apertureRef": {
          "$ref": "#/$defs/NullableIdentifier"
        },
        "effectiveAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "sourceRefs": {
          "allOf": [
            {
              "$ref": "#/$defs/References"
            },
            {
              "type": "array",
              "minItems": 1
            }
          ]
        },
        "epistemicStatus": {
          "$ref": "#/$defs/EpistemicStatus"
        },
        "semanticParentage": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "relationType": {
                "const": "primary_parent"
              }
            },
            "required": [
              "relationType"
            ]
          },
          "then": {
            "properties": {
              "relationRecordKind": {
                "const": "structural_relation"
              },
              "semanticParentage": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relationType": {
                "not": {
                  "const": "primary_parent"
                }
              }
            },
            "required": [
              "relationType"
            ]
          },
          "then": {
            "properties": {
              "semanticParentage": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "RoleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referentRef",
        "role"
      ],
      "properties": {
        "referentRef": {
          "$ref": "#/$defs/Identifier"
        },
        "role": {
          "enum": [
            "anchor",
            "target",
            "subject",
            "context",
            "observer",
            "observed",
            "participant",
            "actor",
            "affected",
            "principal",
            "delegate",
            "steward",
            "other"
          ]
        }
      }
    },
    "EpistemicStatus": {
      "enum": [
        "observed",
        "reported",
        "inferred",
        "assumed",
        "predicted",
        "disputed",
        "unknown"
      ]
    },
    "AddressBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pathProvesParentage",
        "pathProvesIdentity",
        "pathProvesConsent",
        "pathGrantsAuthority",
        "pathGrantsMutation",
        "pathProvesContainment",
        "viewChangesRelationshipIdentity",
        "inversePreservesAuthority"
      ],
      "properties": {
        "pathProvesParentage": {
          "const": false
        },
        "pathProvesIdentity": {
          "const": false
        },
        "pathProvesConsent": {
          "const": false
        },
        "pathGrantsAuthority": {
          "const": false
        },
        "pathGrantsMutation": {
          "const": false
        },
        "pathProvesContainment": {
          "const": false
        },
        "viewChangesRelationshipIdentity": {
          "const": false
        },
        "inversePreservesAuthority": {
          "const": false
        }
      }
    },
    "ExtensionBag": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+(?:/[A-Za-z0-9._~-]+)?$"
      },
      "additionalProperties": true
    }
  }
}
