{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yawn.ai/schemas/interaction-operator-receipt.v0.1.schema.json",
  "title": "YAWN Interaction Operator Receipt V0.1",
  "description": "A non-authoritative receipt binding one explicit interaction operator to one exact source, question event, detection, or proposal. It records review or response state only; it cannot establish truth, ratify an objective, activate a bot, grant authority, mutate canonical state, or authorize external effects.",
  "$comment": "Schema and document-local semantic validation do not authenticate actor/principal identity, resolve SourceEvidenceRef values through the stable Source contract, resolve reviewed records, prove the claimed fromStatus is current, enforce receiptId uniqueness/idempotency, or enforce privacy/egress policy. Before any View transition, consumers must close those checks against append-only state, accept an exact same-ID/same-bytes replay only as idempotent, reject same-ID/different-bytes conflicts, and fail closed if Response.visibility would widen the resolved Source boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "operator",
    "reviewScope",
    "actorRef",
    "principalRef",
    "subject",
    "interactionSourceRefs",
    "response",
    "correction",
    "additionalEvidenceRefs",
    "relatedSubjectRefs",
    "result",
    "effects",
    "canonicalState",
    "notAuthority",
    "recordedAt",
    "extensions"
  ],
  "properties": {
    "schemaVersion": { "const": "yawn.interaction.operator-receipt.v0.1" },
    "receiptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^receipt:interaction:[^\\s]+$"
    },
    "operator": {
      "enum": [
        "confirm",
        "reject",
        "correct",
        "add_more",
        "split",
        "link",
        "hold",
        "answer",
        "mark_unknown",
        "mark_disputed",
        "skip",
        "defer",
        "withhold",
        "mark_not_applicable"
      ]
    },
    "reviewScope": {
      "enum": ["source_record", "question_response", "detection_mapping", "proposal_review"]
    },
    "actorRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(actor|principal):[^\\s]+$"
    },
    "principalRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 11,
          "maxLength": 500,
          "pattern": "^principal:[^\\s]+$"
        },
        { "type": "null" }
      ]
    },
    "subject": {
      "oneOf": [
        { "$ref": "#/$defs/SourceSubject" },
        { "$ref": "#/$defs/QuestionEventSubject" },
        { "$ref": "#/$defs/DetectionSubject" },
        { "$ref": "#/$defs/ProposalSubject" }
      ]
    },
    "interactionSourceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/SourceEvidenceRef" }
    },
    "response": {
      "anyOf": [
        { "$ref": "#/$defs/Response" },
        { "type": "null" }
      ]
    },
    "correction": {
      "anyOf": [
        { "$ref": "#/$defs/Correction" },
        { "type": "null" }
      ]
    },
    "additionalEvidenceRefs": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/SourceEvidenceRef" }
    },
    "relatedSubjectRefs": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/EvidenceRef" }
    },
    "result": { "$ref": "#/$defs/Result" },
    "effects": { "$ref": "#/$defs/NonAuthorityEffects" },
    "canonicalState": { "const": false },
    "notAuthority": { "const": true },
    "recordedAt": { "$ref": "#/$defs/Timestamp" },
    "extensions": { "$ref": "#/$defs/ExtensionBag" }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "maxLength": 100,
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "ExactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "stateSha256"],
      "properties": {
        "kind": {
          "allOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            { "not": { "const": "source" } }
          ]
        },
        "id": { "$ref": "#/$defs/Identifier" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "stateSha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "SourceEvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "sourceSha256"],
      "properties": {
        "kind": { "const": "source" },
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "The constitutional SourceRecord.id UUID. This uses the same format contract without narrowing UUID version or case. A human-readable sourceKey is resolved on the SourceRecord and is never substituted for this identity."
        },
        "sourceSha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "EvidenceRef": {
      "oneOf": [
        { "$ref": "#/$defs/SourceEvidenceRef" },
        { "$ref": "#/$defs/ExactRef" }
      ]
    },
    "SourceSubject": {
      "$ref": "#/$defs/SourceEvidenceRef"
    },
    "QuestionEventSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision",
        "stateSha256",
        "questionKey",
        "questionPacketRef",
        "questionPacketSha256",
        "exactRenderedPrompt",
        "exactRenderedPromptSha256",
        "selectionReceiptRef",
        "orientationMapId",
        "orientationMapRevision"
      ],
      "properties": {
        "kind": { "const": "question_event" },
        "id": {
          "allOf": [
            { "$ref": "#/$defs/Identifier" },
            { "type": "string", "pattern": "^question-event:[^\\s]+$" }
          ]
        },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "stateSha256": { "$ref": "#/$defs/Sha256" },
        "questionKey": {
          "enum": [
            "scope",
            "placement",
            "perspective",
            "current-state",
            "intent",
            "lacuna",
            "boundary",
            "movement",
            "proof"
          ]
        },
        "questionPacketRef": { "$ref": "#/$defs/Identifier" },
        "questionPacketSha256": { "$ref": "#/$defs/Sha256" },
        "exactRenderedPrompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "exactRenderedPromptSha256": { "$ref": "#/$defs/Sha256" },
        "selectionReceiptRef": {
          "allOf": [
            { "$ref": "#/$defs/ExactRef" },
            {
              "type": "object",
              "properties": { "kind": { "const": "inquiry_selection_receipt" } }
            }
          ]
        },
        "orientationMapId": { "$ref": "#/$defs/Identifier" },
        "orientationMapRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "DetectionSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "stateSha256", "compileProjectionRef", "sourceRefs"],
      "properties": {
        "kind": { "const": "detection" },
        "id": {
          "allOf": [
            { "$ref": "#/$defs/Identifier" },
            { "type": "string", "pattern": "^detection:[^\\s]+$" }
          ]
        },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "stateSha256": { "$ref": "#/$defs/Sha256" },
        "compileProjectionRef": {
          "allOf": [
            { "$ref": "#/$defs/ExactRef" },
            {
              "type": "object",
              "properties": { "kind": { "const": "compile_projection" } }
            }
          ]
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/SourceEvidenceRef" }
        }
      }
    },
    "ProposalSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "stateSha256", "proposalType", "contextRef", "basisRefs"],
      "properties": {
        "kind": { "const": "proposal" },
        "id": { "$ref": "#/$defs/Identifier" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "stateSha256": { "$ref": "#/$defs/Sha256" },
        "proposalType": {
          "enum": [
            "answer_mapping",
            "detection_mapping",
            "routing_candidate",
            "structural_operation",
            "objective_candidate",
            "presentation_candidate"
          ]
        },
        "contextRef": { "$ref": "#/$defs/EvidenceRef" },
        "basisRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/EvidenceRef" }
        }
      }
    },
    "Response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawResponseSha256", "sourceRefs", "assertedBy", "epistemicStatus", "visibility"],
      "properties": {
        "rawResponseSha256": { "$ref": "#/$defs/Sha256" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/SourceEvidenceRef" }
        },
        "assertedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(actor|principal):[^\\s]+$"
        },
        "epistemicStatus": { "enum": ["reported", "unknown", "disputed"] },
        "visibility": { "enum": ["private", "shared", "public"] }
      }
    },
    "Correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originalPreserved", "replacementSourceRefs", "changedFields"],
      "properties": {
        "originalPreserved": { "const": true },
        "replacementSourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/SourceEvidenceRef" }
        },
        "changedFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^/"
          }
        }
      }
    },
    "MappingTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromStatus", "toStatus"],
      "properties": {
        "fromStatus": { "enum": ["unmapped", "proposed", "accepted", "corrected", "rejected"] },
        "toStatus": { "enum": ["proposed", "accepted", "corrected", "rejected"] }
      }
    },
    "AnswerTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionEventRef", "fromStatus", "toStatus", "basis", "responseSourceRefs"],
      "properties": {
        "questionEventRef": {
          "allOf": [
            { "$ref": "#/$defs/ExactRef" },
            {
              "type": "object",
              "properties": { "kind": { "const": "question_event" } }
            }
          ]
        },
        "fromStatus": {
          "enum": [
            "unasked",
            "answered",
            "proposed",
            "corrected",
            "skipped",
            "unknown",
            "disputed",
            "deferred",
            "withheld",
            "not_applicable"
          ]
        },
        "toStatus": {
          "enum": [
            "answered",
            "corrected",
            "skipped",
            "unknown",
            "disputed",
            "deferred",
            "withheld",
            "not_applicable"
          ]
        },
        "basis": {
          "enum": [
            "explicit_response",
            "explicit_unknown",
            "explicit_dispute",
            "explicit_skip",
            "explicit_defer",
            "explicit_withhold",
            "explicit_not_applicable"
          ]
        },
        "responseSourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/SourceEvidenceRef" }
        }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectDisposition", "mappingTransition", "answerTransition", "followupRequired"],
      "properties": {
        "subjectDisposition": {
          "enum": [
            "representation_confirmed",
            "representation_rejected",
            "correction_recorded",
            "evidence_added",
            "split_proposed",
            "link_proposed",
            "held",
            "response_recorded",
            "marked_unknown",
            "marked_disputed",
            "skipped",
            "deferred",
            "withheld",
            "marked_not_applicable"
          ]
        },
        "mappingTransition": {
          "anyOf": [
            { "$ref": "#/$defs/MappingTransition" },
            { "type": "null" }
          ]
        },
        "answerTransition": {
          "anyOf": [
            { "$ref": "#/$defs/AnswerTransition" },
            { "type": "null" }
          ]
        },
        "followupRequired": { "type": "boolean" }
      }
    },
    "NonAuthorityEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalMutationAuthorized",
        "truthEstablished",
        "objectiveRatified",
        "botActivated",
        "authorityGranted",
        "effectAuthorityGranted",
        "externalEffectsAuthorized"
      ],
      "properties": {
        "canonicalMutationAuthorized": { "const": false },
        "truthEstablished": { "const": false },
        "objectiveRatified": { "const": false },
        "botActivated": { "const": false },
        "authorityGranted": { "const": false },
        "effectAuthorityGranted": { "const": false },
        "externalEffectsAuthorized": { "const": false }
      }
    },
    "ExtensionBag": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": { "pattern": "^x-[a-z0-9][a-z0-9._-]*$" }
    }
  }
}
