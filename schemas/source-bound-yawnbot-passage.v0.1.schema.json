{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yawn.ai/schemas/source-bound-yawnbot-passage.v0.1.schema.json",
  "title": "YAWN Source-Bound Cognitive Passage Records V0.1",
  "description": "Expression provision, projection, move, consequence, proof adjudication, update, relation, and noncanonical traversal View records.",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "NonBlankText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64000,
      "pattern": "\\S"
    },
    "OptionalRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "Refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Identifier"
      }
    },
    "RequiredRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Identifier"
      }
    },
    "ExpressionProvision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provisionId",
        "revision",
        "modelRef",
        "questionRefs",
        "positionRefs",
        "purpose",
        "audiencePolicyRef",
        "arenaRef",
        "medium",
        "aperture",
        "interactionAffordances",
        "allowedProjectionKinds",
        "constraints",
        "sourceRefs",
        "status",
        "createdAt"
      ],
      "properties": {
        "provisionId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "modelRef": {
          "$ref": "#/$defs/Identifier"
        },
        "questionRefs": {
          "$ref": "#/$defs/Refs"
        },
        "positionRefs": {
          "$ref": "#/$defs/Refs"
        },
        "purpose": {
          "$ref": "#/$defs/NonBlankText"
        },
        "audiencePolicyRef": {
          "$ref": "#/$defs/Identifier"
        },
        "arenaRef": {
          "$ref": "#/$defs/Identifier"
        },
        "medium": {
          "$ref": "#/$defs/NonBlankText"
        },
        "aperture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "includedRefs",
            "withheldRefs",
            "timeRange",
            "depth",
            "redactionPolicyRefs"
          ],
          "properties": {
            "includedRefs": {
              "$ref": "#/$defs/RequiredRefs"
            },
            "withheldRefs": {
              "$ref": "#/$defs/Refs"
            },
            "timeRange": {
              "$ref": "#/$defs/NonBlankText"
            },
            "depth": {
              "enum": [
                "summary",
                "standard",
                "deep",
                "source_level"
              ]
            },
            "redactionPolicyRefs": {
              "$ref": "#/$defs/Refs"
            }
          }
        },
        "interactionAffordances": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "inspect_sources",
              "ask",
              "confirm",
              "reject",
              "correct",
              "add_more",
              "defer",
              "request_access",
              "connect",
              "download",
              "choose_move"
            ]
          }
        },
        "allowedProjectionKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "statement",
              "question",
              "explanation",
              "story",
              "visual",
              "request",
              "invitation",
              "disclosure",
              "proposal",
              "commitment",
              "other"
            ]
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NonBlankText"
          }
        },
        "sourceRefs": {
          "$ref": "#/$defs/RequiredRefs"
        },
        "status": {
          "enum": [
            "proposed",
            "approved",
            "retired"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionId",
        "revision",
        "provisionRef",
        "projectorRef",
        "arenaRef",
        "projectionKind",
        "contentRef",
        "sourceRefs",
        "status",
        "projectedAt"
      ],
      "properties": {
        "projectionId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "provisionRef": {
          "$ref": "#/$defs/Identifier"
        },
        "projectorRef": {
          "$ref": "#/$defs/Identifier"
        },
        "arenaRef": {
          "$ref": "#/$defs/Identifier"
        },
        "projectionKind": {
          "enum": [
            "statement",
            "question",
            "explanation",
            "story",
            "visual",
            "request",
            "invitation",
            "disclosure",
            "proposal",
            "commitment",
            "other"
          ]
        },
        "contentRef": {
          "$ref": "#/$defs/Identifier"
        },
        "sourceRefs": {
          "$ref": "#/$defs/RequiredRefs"
        },
        "status": {
          "enum": [
            "draft",
            "projected",
            "withdrawn",
            "superseded"
          ]
        },
        "projectedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Move": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moveId",
        "revision",
        "projectionRef",
        "description",
        "proposedBy",
        "expectedConsequences",
        "choiceEventRef",
        "authorizationRefs",
        "proofConditionRef",
        "sourceRefs",
        "status",
        "executedAt"
      ],
      "properties": {
        "moveId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "projectionRef": {
          "$ref": "#/$defs/Identifier"
        },
        "description": {
          "$ref": "#/$defs/NonBlankText"
        },
        "proposedBy": {
          "$ref": "#/$defs/Identifier"
        },
        "expectedConsequences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/NonBlankText"
          }
        },
        "choiceEventRef": {
          "$ref": "#/$defs/OptionalRef"
        },
        "authorizationRefs": {
          "$ref": "#/$defs/Refs"
        },
        "proofConditionRef": {
          "$ref": "#/$defs/OptionalRef"
        },
        "sourceRefs": {
          "$ref": "#/$defs/RequiredRefs"
        },
        "status": {
          "enum": [
            "proposed",
            "selected",
            "authorized",
            "executed",
            "blocked",
            "abandoned"
          ]
        },
        "executedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Consequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consequenceId",
        "revision",
        "moveRef",
        "description",
        "observedBy",
        "epistemicStatus",
        "causalStatus",
        "evidenceRefs",
        "sourceRefs",
        "occurredAt"
      ],
      "properties": {
        "consequenceId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "moveRef": {
          "$ref": "#/$defs/Identifier"
        },
        "description": {
          "$ref": "#/$defs/NonBlankText"
        },
        "observedBy": {
          "$ref": "#/$defs/Identifier"
        },
        "epistemicStatus": {
          "enum": [
            "reported",
            "observed",
            "inferred",
            "disputed",
            "unknown"
          ]
        },
        "causalStatus": {
          "enum": [
            "caused",
            "contributed",
            "correlated",
            "disputed",
            "unknown"
          ]
        },
        "evidenceRefs": {
          "$ref": "#/$defs/Refs"
        },
        "sourceRefs": {
          "$ref": "#/$defs/RequiredRefs"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ProofAdjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proofId",
        "revision",
        "moveRef",
        "consequenceRefs",
        "evaluationRefs",
        "proofConditionRef",
        "adjudicatedBy",
        "result",
        "rationale",
        "evidenceRefs",
        "sourceRefs",
        "status",
        "adjudicatedAt"
      ],
      "properties": {
        "proofId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "moveRef": {
          "$ref": "#/$defs/Identifier"
        },
        "consequenceRefs": {
          "$ref": "#/$defs/Refs"
        },
        "evaluationRefs": {
          "$ref": "#/$defs/Refs"
        },
        "proofConditionRef": {
          "$ref": "#/$defs/Identifier"
        },
        "adjudicatedBy": {
          "$ref": "#/$defs/Identifier"
        },
        "result": {
          "enum": [
            "satisfied",
            "partially_satisfied",
            "not_satisfied",
            "insufficient_evidence",
            "contested"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/NonBlankText"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/Refs"
        },
        "sourceRefs": {
          "$ref": "#/$defs/RequiredRefs"
        },
        "status": {
          "enum": [
            "proposed",
            "recorded",
            "accepted",
            "disputed",
            "superseded"
          ]
        },
        "adjudicatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "updateId",
        "revision",
        "triggerRefs",
        "changedRef",
        "beforeRevision",
        "afterRevision",
        "summary",
        "authorizedByEventRef",
        "sourceRefs",
        "status",
        "recordedAt"
      ],
      "properties": {
        "updateId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "triggerRefs": {
          "$ref": "#/$defs/RequiredRefs"
        },
        "changedRef": {
          "$ref": "#/$defs/Identifier"
        },
        "beforeRevision": {
          "type": "integer",
          "minimum": 1
        },
        "afterRevision": {
          "type": "integer",
          "minimum": 2
        },
        "summary": {
          "$ref": "#/$defs/NonBlankText"
        },
        "authorizedByEventRef": {
          "$ref": "#/$defs/OptionalRef"
        },
        "sourceRefs": {
          "$ref": "#/$defs/RequiredRefs"
        },
        "status": {
          "enum": [
            "proposed",
            "authorized",
            "applied",
            "rejected"
          ]
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationId",
        "revision",
        "fromRef",
        "relationKind",
        "toRef",
        "assertedBy",
        "epistemicStatus",
        "confidence",
        "sourceRefs",
        "status"
      ],
      "properties": {
        "relationId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "fromRef": {
          "$ref": "#/$defs/Identifier"
        },
        "relationKind": {
          "enum": [
            "answers",
            "provisions",
            "projects",
            "attempts",
            "observed_as",
            "evaluated_by",
            "measured_against",
            "supported_by",
            "conflicts_with",
            "amplifies",
            "mutes",
            "couples_to",
            "decouples_from",
            "derived_from",
            "updates",
            "opens_question",
            "represented_by",
            "other"
          ]
        },
        "toRef": {
          "$ref": "#/$defs/Identifier"
        },
        "assertedBy": {
          "$ref": "#/$defs/Identifier"
        },
        "epistemicStatus": {
          "enum": [
            "reported",
            "observed",
            "inferred",
            "assumed",
            "predicted",
            "disputed",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sourceRefs": {
          "$ref": "#/$defs/RequiredRefs"
        },
        "status": {
          "enum": [
            "proposed",
            "reported",
            "accepted_as_attributed",
            "disputed",
            "superseded"
          ]
        }
      }
    },
    "TraversalView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewId",
        "modelRef",
        "canonicalSemanticState",
        "defaultOrder",
        "visibleRefs",
        "sourceRefs",
        "createdAt"
      ],
      "properties": {
        "viewId": {
          "$ref": "#/$defs/Identifier"
        },
        "modelRef": {
          "$ref": "#/$defs/Identifier"
        },
        "canonicalSemanticState": {
          "const": false
        },
        "defaultOrder": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "question",
              "position",
              "expression_provision",
              "projection",
              "move",
              "consequence",
              "evaluation",
              "proof_adjudication",
              "update",
              "next_question_or_hold"
            ]
          }
        },
        "visibleRefs": {
          "$ref": "#/$defs/RequiredRefs"
        },
        "sourceRefs": {
          "$ref": "#/$defs/RequiredRefs"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
