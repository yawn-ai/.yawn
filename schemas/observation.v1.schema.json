{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yawn.ai/schemas/observation.v1.schema.json",
  "title": "YAWN Observation State V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "observationId", "observerRef", "agentSpaceRef", "arenaRef",
    "observedYawnRefs", "sourceSpans", "whatBecameAvailable", "observerAdded",
    "inferences", "conditions", "limits", "remainsOpen", "proofRefs",
    "epistemicStatus", "confidence", "status", "revision", "observedAt",
    "recordedAt", "updatedAt", "previousStateSha256", "extensions"
  ],
  "properties": {
    "schemaVersion": { "const": "yawn.observation-state.v1" },
    "observationId": { "type": "string", "minLength": 1 },
    "observerRef": { "type": "string", "minLength": 1 },
    "agentSpaceRef": { "type": "string", "minLength": 1 },
    "arenaRef": { "type": ["string", "null"], "minLength": 1 },
    "observedYawnRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "sourceSpans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceRef", "sourceSha256", "startCharacter", "endCharacter", "coordinate"],
        "properties": {
          "sourceRef": { "type": "string", "minLength": 1 },
          "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "startCharacter": { "type": "integer", "minimum": 0 },
          "endCharacter": { "type": "integer", "minimum": 0 },
          "coordinate": { "type": "object" }
        }
      }
    },
    "whatBecameAvailable": { "type": "string", "minLength": 1, "maxLength": 64000, "pattern": "\\S" },
    "observerAdded": { "$ref": "#/$defs/SourceStatements" },
    "inferences": { "$ref": "#/$defs/InferenceStatements" },
    "conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "limits": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "remainsOpen": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "proofRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "epistemicStatus": { "enum": ["observed", "reported", "inferred", "assumed", "predicted", "disputed", "unknown"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "enum": ["accepted", "superseded"] },
    "revision": { "type": "integer", "minimum": 1 },
    "observedAt": { "type": ["string", "null"], "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "previousStateSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$" }
    }
  },
  "$defs": {
    "SourceStatements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "assertedBy", "epistemicStatus", "confidence", "sourceSpanIndexes"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "assertedBy": { "type": "string", "minLength": 1 },
          "epistemicStatus": { "enum": ["observed", "reported", "disputed", "unknown"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sourceSpanIndexes": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "InferenceStatements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "assertedBy", "epistemicStatus", "confidence", "sourceSpanIndexes"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "assertedBy": { "type": "string", "minLength": 1 },
          "epistemicStatus": { "enum": ["inferred", "assumed", "predicted", "disputed", "unknown"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sourceSpanIndexes": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }
        }
      }
    }
  }
}
