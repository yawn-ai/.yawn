{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yawn.ai/schemas/desire.v1.schema.json",
  "title": "YawnDesireV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "desireId", "principalRef", "description", "sourceRefs", "authorityStatus", "visibility"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "desireId": { "type": "string", "minLength": 1 },
    "principalRef": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "sourceRefs": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "authorityStatus": { "enum": ["self_reported", "inferred", "endorsed", "rejected"] },
    "visibility": { "enum": ["private", "shared", "public"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
